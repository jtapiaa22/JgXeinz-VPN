importar_usuarios(){
  banner "IMPORTAR USUARIOS DEL SISTEMA"
  echo -e "Agrega al panel los usuarios del sistema que no esten en la lista"
  echo -e "(UID >= 1000) y los suma al grupo ${CYAN}$VPN_GROUP${NC} para poder gestionarlos.\n"
  local n=0
  while IFS=: read -r u _ uid _; do
    [[ "$uid" =~ ^[0-9]+$ ]] || continue
    [[ "$uid" -ge 1000 ]] || continue
    is_system_user "$u" && continue
    if ! grep -q "^$u " "$DB"; then
      usermod -aG "$VPN_GROUP" "$u" 2>/dev/null
      echo "$u 1" >> "$DB"
      add_traffic_rule "$u"
      echo -e "${GREEN}Importado: $u${NC}"; n=$((n+1))
    fi
  done < /etc/passwd
  echo -e "\n${GREEN}$n usuario(s) importado(s) (limite por defecto: 1)${NC}"
  [[ $n -gt 0 ]] && echo -e "${YELLOW}Ajustá su limite/fecha con las opciones 06 y 05 si hace falta.${NC}"
  pause
}

estado_servicios(){
  banner "ESTADO DE SERVICIOS"
  local svcs=(ssh fail2ban squid openvpn@server stunnel4 sslh jgx-dropbear jgx-limiter jgx-userbanner)
  for s in "${svcs[@]}"; do
    if systemctl is-active --quiet "$s" 2>/dev/null; then
      printf " %-18s ${GREEN}%s${NC}\n" "$s" "ACTIVO"
    else
      printf " %-18s ${RED}%s${NC}\n" "$s" "inactivo"
    fi
  done
  echo ""
  echo -e "${YELLOW}[1]${NC} Ver logs de un servicio"
  echo -e "${YELLOW}[2]${NC} Reiniciar un servicio"
  echo -e "${YELLOW}[0]${NC} Volver"
  echo ""; read -rp "Opcion: " o
  case $o in
    1) read -rp "Servicio: " s; echo ""; journalctl -u "$s" -n 30 --no-pager 2>/dev/null; pause;;
    2) read -rp "Servicio: " s; systemctl restart "$s" 2>/dev/null && echo -e "${GREEN}Reiniciado${NC}" || echo -e "${RED}No se pudo${NC}"; pause;;
    0) :;;
  esac
}

desinstalar(){
  banner; echo -e "${RED} DESINSTALAR JgXeinz VPN${NC}\n"
  echo -e "${YELLOW}Esto quita el panel, sus servicios y el comando 'menu'.${NC}"
  echo -e "${YELLOW}No se puede deshacer.${NC}\n"
  read -rp "Escribi SI (en mayuscula) para confirmar: " c
  [[ "$c" != "SI" ]] && { echo -e "\n${GREEN}Cancelado${NC}"; pause; return; }

  echo ""
  read -rp "Borrar tambien los usuarios creados por el panel? [s/n]: " du
  if [[ "$du" =~ ^[sS]$ ]]; then
    # solo los del grupo del panel; nunca usuarios del sistema
    while read -r u; do
      [[ -z "$u" ]] && continue
      is_system_user "$u" && continue
      pkill -u "$u" 2>/dev/null; userdel --force "$u" 2>/dev/null
    done < <(getent group "$VPN_GROUP" | awk -F: '{print $4}' | tr ',' '\n' | grep -v '^$')
    echo -e "${GREEN}Usuarios del panel eliminados${NC}"
  fi

  echo -e "\n${YELLOW}Removiendo servicios y archivos...${NC}"
  for u in $(systemctl list-units 'jgx-ws@*' 'jgx-badvpn@*' --all --no-legend 2>/dev/null | awk '{print $1}'); do
    systemctl disable --now "$u" 2>/dev/null
  done
  systemctl disable --now jgx-limiter jgx-ws jgx-badvpn jgx-userbanner jgx-dropbear jgx-reboot.timer 2>/dev/null
  rm -f /etc/systemd/system/jgx-ws@.service /etc/systemd/system/jgx-badvpn@.service \
        /etc/systemd/system/jgx-badvpn.service /etc/systemd/system/jgx-limiter.service \
        /etc/systemd/system/jgx-userbanner.service /etc/systemd/system/jgx-dropbear.service         /etc/systemd/system/jgx-reboot.timer /etc/systemd/system/jgx-reboot.service
  systemctl daemon-reload

  rm -f /etc/ssh/sshd_config.d/10-jgxeinz-banner.conf
  rm -f /etc/ssh/sshd_config.d/20-jgxeinz-group.conf
  rm -f "$UB_CONF"
  systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null

  rm -rf /etc/jgxeinz
  rm -f /usr/bin/menu

  clear
  echo -e "${GREEN}JgXeinz VPN desinstalado.${NC}\n"
  echo -e "${YELLOW}Nota: Dropbear, Squid, SSL Tunnel, SSLH, OpenVPN, fail2ban y el binario"
  echo -e "badvpn quedan instalados (si los querés sacar, se hace a mano).${NC}"
  echo -e "${YELLOW}El grupo $VPN_GROUP y el login por contrasena del SSH quedan como estan.${NC}\n"
  echo -e "${CYAN}Para reinstalar, corré el install.sh de nuevo.${NC}"
  sleep 1
  exit 0
}

# --------------------------------------------------------------
#  SPEEDTEST
# --------------------------------------------------------------
# usa el CLI oficial de Ookla (se descarga una vez a $DIR/bin); si no se puede,
# cae a una medicion simple contra Cloudflare con curl.
ST_BIN="$DIR/bin/speedtest"

speedtest_get(){
  [[ -x "$ST_BIN" ]] && return 0
  local arch tmp
  case "$(uname -m)" in
    x86_64) arch="x86_64";; aarch64|arm64) arch="aarch64";; armv7l) arch="armhf";; *) return 1;;
  esac
  echo -e "${YELLOW}Descargando speedtest (Ookla) por unica vez...${NC}"
  tmp=$(mktemp -d)
  if curl -fsSL --max-time 60 "https://install.speedtest.net/app/cli/ookla-speedtest-1.2.0-linux-${arch}.tgz" -o "$tmp/st.tgz" \
     && tar -xzf "$tmp/st.tgz" -C "$tmp" speedtest 2>/dev/null; then
    mkdir -p "$DIR/bin"; mv -f "$tmp/speedtest" "$ST_BIN"; chmod +x "$ST_BIN"
  fi
  rm -rf "$tmp"
  [[ -x "$ST_BIN" ]]
}

# Mbps a partir de bytes/seg
st_mbps(){ awk -v b="$1" 'BEGIN{printf "%.2f", b*8/1000000}'; }

st_fila(){ printf " ${GRAY}%-11s${NC}%b\n" "$1" "$2"; }

speedtest_cloudflare(){
  echo -e "${YELLOW}Midiendo contra Cloudflare...${NC}\n"
  local ping down up
  ping=$(curl -s -o /dev/null --max-time 10 -w '%{time_connect}' https://speed.cloudflare.com/ 2>/dev/null)
  echo -ne " ${GRAY}bajada...${NC}\r"
  down=$(curl -s -o /dev/null --max-time 30 -w '%{speed_download}' 'https://speed.cloudflare.com/__down?bytes=100000000' 2>/dev/null)
  echo -ne " ${GRAY}subida...${NC}\r"
  up=$(head -c 25000000 /dev/zero | curl -s -o /dev/null --max-time 30 -w '%{speed_upload}' --data-binary @- https://speed.cloudflare.com/__up 2>/dev/null)
  echo -ne "              \r"
  [[ -z "$down" || "$down" == 0* && "$up" == 0* ]] && { echo -e "${RED}No se pudo medir (sin salida a internet?)${NC}"; return; }
  st_fila "Servidor"  "Cloudflare (mas cercano)"
  st_fila "Ping"      "$(awk -v t="$ping" 'BEGIN{printf "%.0f ms", t*1000}')"
  st_fila "Bajada"    "${GREEN}$(st_mbps "${down%.*}") Mbps${NC}"
  st_fila "Subida"    "${GREEN}$(st_mbps "${up%.*}") Mbps${NC}"
}

speedtest_run(){
  banner "SPEEDTEST DEL VPS"
  echo -e "Mide la velocidad del VPS hacia internet (no la de tus clientes)."
  echo -e "${GRAY}Ojo: en AWS la subida cuenta como trafico saliente (~100-300 MB por test).${NC}\n"
  if ! speedtest_get; then
    echo -e "${YELLOW}No se pudo bajar el speedtest de Ookla; uso el test simple.${NC}\n"
    speedtest_cloudflare; pause; return
  fi
  echo -e "${YELLOW}Midiendo... (tarda unos 20-40 segundos)${NC}\n"
  local json; json=$("$ST_BIN" --accept-license --accept-gdpr -f json 2>/dev/null)
  if [[ -z "$json" ]]; then
    echo -e "${YELLOW}Ookla no respondio; uso el test simple.${NC}\n"
    speedtest_cloudflare; pause; return
  fi
  # una linea por dato, en orden fijo
  local r; mapfile -t r < <(python3 - "$json" <<'PY'
import json, sys
d = json.loads(sys.argv[1])
s = d.get("server", {})
print("%s - %s" % (s.get("name", "?"), s.get("location", "?")))
print(d.get("isp", "?"))
print("%.0f" % d["ping"]["latency"])
print("%.1f" % d["ping"].get("jitter", 0))
print(d["download"]["bandwidth"])
print(d["upload"]["bandwidth"])
pl = d.get("packetLoss")
print("-" if pl is None else "%.1f" % pl)
print(d.get("result", {}).get("url", ""))
PY
)
  [[ ${#r[@]} -lt 7 ]] && { echo -e "${RED}No se pudo leer el resultado${NC}"; pause; return; }
  st_fila "Servidor"  "${r[0]}"
  st_fila "Proveedor" "${r[1]}"
  st_fila "Ping"      "${r[2]} ms ${GRAY}(jitter ${r[3]} ms)${NC}"
  st_fila "Bajada"    "${GREEN}$(st_mbps "${r[4]}") Mbps${NC}"
  st_fila "Subida"    "${GREEN}$(st_mbps "${r[5]}") Mbps${NC}"
  st_fila "Perdida"   "${r[6]}%"
  [[ -n "${r[7]}" ]] && st_fila "Resultado" "${CYAN}${r[7]}${NC}"
  pause
}

# --------------------------------------------------------------
#  REINICIAR VPS
# --------------------------------------------------------------
# reinicio desde adentro del sistema: anda en cualquier proveedor.
# el automatico es un timer de systemd (algunas imagenes minimas no traen cron)
# y usa la zona horaria del VPS (Herramientas > Zona horaria).
reiniciar_mgr(){
  while true; do
    banner "REINICIAR VPS"
    local hora; hora=$(grep -oP '^OnCalendar=\*-\*-\* \K[0-9]{2}:[0-9]{2}' /etc/systemd/system/jgx-reboot.timer 2>/dev/null)
    if systemctl is-active --quiet jgx-reboot.timer 2>/dev/null; then
      echo -e " Reinicio automatico: ${GREEN}todos los dias a las $hora${NC}"
    else
      echo -e " Reinicio automatico: ${RED}OFF${NC}"
    fi
    echo -e " ${GRAY}Hora del VPS: $(date +%H:%M) ($(timedatectl show -p Timezone --value 2>/dev/null))${NC}\n"
    echo -e "${YELLOW}[1]${NC} Reiniciar ahora"
    echo -e "${YELLOW}[2]${NC} Reinicio automatico diario (activar / cambiar hora)"
    echo -e "${YELLOW}[3]${NC} Quitar reinicio automatico"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " o
    case $o in
      1)
        echo -e "\n${YELLOW}Se van a cortar todas las conexiones (la tuya tambien).${NC}"
        echo -e "${YELLOW}El VPS vuelve en 1-2 minutos con los servicios del panel activos.${NC}"
        read -rp "Reiniciar ahora? [s/n]: " r
        if [[ "$r" =~ ^[sS]$ ]]; then
          echo -e "\n${GREEN}Reiniciando... volve a entrar en un par de minutos.${NC}"
          sync; sleep 1; systemctl reboot
          exit 0
        fi;;
      2)
        read -rp "Hora del reinicio (HH:MM, ej 05:00) [05:00]: " h
        [[ -z "$h" ]] && h="05:00"
        [[ "$h" =~ ^[0-9]{1,2}:[0-9]{2}$ ]] || { echo -e "${RED}Hora invalida${NC}"; pause; continue; }
        local hh=${h%%:*} mm=${h##*:}
        (( 10#$hh <= 23 && 10#$mm <= 59 )) || { echo -e "${RED}Hora invalida${NC}"; pause; continue; }
        h=$(printf '%02d:%02d' "$((10#$hh))" "$((10#$mm))")
        cat > /etc/systemd/system/jgx-reboot.service <<UNIT
[Unit]
Description=JgXeinz reinicio programado
[Service]
Type=oneshot
ExecStart=/bin/systemctl reboot
UNIT
        cat > /etc/systemd/system/jgx-reboot.timer <<UNIT
[Unit]
Description=JgXeinz reinicio diario
[Timer]
OnCalendar=*-*-* $h:00
[Install]
WantedBy=timers.target
UNIT
        systemctl daemon-reload
        systemctl enable --now jgx-reboot.timer >/dev/null 2>&1
        systemctl restart jgx-reboot.timer >/dev/null 2>&1
        systemctl is-active --quiet jgx-reboot.timer \
          && echo -e "\n${GREEN}Listo: el VPS se reinicia todos los dias a las $h.${NC}" \
          || echo -e "\n${RED}No se pudo programar${NC}"
        pause;;
      3)
        systemctl disable --now jgx-reboot.timer >/dev/null 2>&1
        rm -f /etc/systemd/system/jgx-reboot.timer /etc/systemd/system/jgx-reboot.service
        systemctl daemon-reload
        echo -e "\n${GREEN}Reinicio automatico quitado${NC}"; pause;;
      0) break;;
      *) echo -e "${RED}Opcion invalida${NC}"; sleep 1;;
    esac
  done
}

herramientas(){
  while true; do
    banner "HERRAMIENTAS"
    echo -e "${YELLOW}[1]${NC} Optimizar red (BBR)"
    echo -e "${YELLOW}[2]${NC} Banner / mensaje de conexion"
    echo -e "${YELLOW}[3]${NC} Trafico por usuario"
    echo -e "${YELLOW}[4]${NC} Dominio del servidor"
    echo -e "${YELLOW}[5]${NC} Importar usuarios del sistema"
    echo -e "${YELLOW}[6]${NC} Zona horaria"
    echo -e "${YELLOW}[7]${NC} Estado de servicios"
    echo -e "${YELLOW}[8]${NC} Info de cuenta en el banner"
    echo -e "${YELLOW}[9]${NC} Speedtest del VPS"
    echo -e "${YELLOW}[10]${NC} Reiniciar VPS"
    echo -e "${YELLOW}[11]${NC} ${RED}Desinstalar el panel${NC}"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " o
    case $o in
      1) optimizar;;
      2) editar_banner;;
      3) trafico;;
      4) set_dominio;;
      5) importar_usuarios;;
      6) set_zona;;
      7) estado_servicios;;
      8) userbanner_mgr;;
      9) speedtest_run;;
      10) reiniciar_mgr;;
      11) desinstalar;;
      0) break;;
      *) echo -e "${RED}Opcion invalida${NC}"; sleep 1;;
    esac
  done
}

# --------------------------------------------------------------
#  BANNER POR USUARIO (usuario / dias restantes / conectados)
# --------------------------------------------------------------
# sshd manda el banner despues de recibir el nombre de usuario, asi que con
# "Match User" cada cuenta puede ver su propio banner: el banner.txt de
# siempre + sus datos. El servicio jgx-userbanner los regenera cada 10s.
# No aplica a Dropbear (tiene un unico banner fijo).
UB_CONF="/etc/ssh/sshd_config.d/30-jgxeinz-userbanners.conf"

userbanner_write(){
  local tmp; tmp=$(mktemp)
  cat > "$tmp" <<'UB'
#!/bin/bash
DIR="/etc/jgxeinz"
DB="$DIR/users.db"
OUT="$DIR/banners"
CONF="/etc/ssh/sshd_config.d/30-jgxeinz-userbanners.conf"
mkdir -p "$OUT"
# sin esto, en bash 5.2 el '&' del reemplazo de ${x//a/b} es "lo encontrado"
shopt -u patsub_replacement 2>/dev/null

# paleta (HTTP Custom interpreta <font color> en el mensaje del servidor)
C_SEP="#00B4D8"; C_TXT="#FFD166"; C_LBL="#AAB4BE"
C_OK="#06D6A0"; C_WARN="#FFD166"; C_BAD="#EF476F"

esc(){ local s="${1//&/&amp;}"; s="${s//</&lt;}"; echo "${s//>/&gt;}"; }
font(){ echo "<font color=\"$1\">$(esc "$2")</font>"; }
dato(){ echo "$(font "$C_LBL" "$1:") $(font "$2" "$3")"; }

# banner base coloreado: el logo (lineas con bloques/bordes) queda blanco,
# los separadores "====" en un color y el resto del texto en otro
base_color(){
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if [[ "$line" == *█* || "$line" == *╗* || "$line" == *╝* || "$line" == *║* ]]; then
      esc "$line"
    elif [[ "$line" =~ ^[[:space:]=_-]+$ && "$line" =~ [=_-] ]]; then
      font "$C_SEP" "$line"
    elif [[ "$line" =~ [^[:space:]] ]]; then
      font "$C_TXT" "$line"
    else
      echo "$line"
    fi
  done < "$DIR/banner.txt"
}

while true; do
  color=1; [[ "$(cat "$DIR/banner_color" 2>/dev/null)" == "off" ]] && color=0
  hoy=$(date -d "$(date +%F)" +%s)
  match=$(mktemp)
  declare -A vivos=()
  while read -r user limite; do
    [[ -z "$user" ]] && continue
    id "$user" &>/dev/null || continue
    vivos[$user]=1
    exp=$(chage -l "$user" 2>/dev/null | awk -F: '/Account expires/{print $2}' | sed 's/^ *//')
    if [[ -z "$exp" || "$exp" == "never" ]]; then
      dias="Ilimitado"; c_dias=$C_OK
    else
      d=$(( ( $(date -d "$exp" +%s 2>/dev/null || echo "$hoy") - hoy ) / 86400 ))
      if (( d <= 0 )); then dias="Vencida"; elif (( d == 1 )); then dias="1 dia"; else dias="$d dias"; fi
      # verde con margen, amarillo si quedan 3 o menos, rojo vencida
      if (( d <= 0 )); then c_dias=$C_BAD; elif (( d <= 3 )); then c_dias=$C_WARN; else c_dias=$C_OK; fi
    fi
    n=$(ps -u "$user" -o comm= 2>/dev/null | grep -cE 'sshd|dropbear')
    c_con=$C_OK; [[ "$limite" =~ ^[0-9]+$ ]] && (( n >= limite )) && c_con=$C_BAD
    f="$OUT/$user.txt"
    {
      if (( color )); then
        [[ -f "$DIR/banner.txt" ]] && base_color
        dato "Usuario" "$C_OK" "$user"
        dato "Dias restantes" "$c_dias" "$dias"
        dato "Conectados" "$c_con" "$n/${limite:--}"
      else
        if [[ -f "$DIR/banner.txt" ]]; then
          cat "$DIR/banner.txt"
          # si el banner no termina en salto de linea, que "Usuario:" no quede pegado
          [[ -n "$(tail -c1 "$DIR/banner.txt")" ]] && echo ""
        fi
        echo "Usuario: $user"
        echo "Dias restantes: $dias"
        echo "Conectados: $n/${limite:--}"
      fi
    } > "$f.tmp" && mv -f "$f.tmp" "$f"
    printf 'Match User %s\n    Banner %s\n' "$user" "$f" >> "$match"
  done < "$DB"
  # borrar banners de usuarios que ya no existen
  for f in "$OUT"/*.txt; do
    [[ -e "$f" ]] || continue
    u=$(basename "$f" .txt)
    [[ -n "${vivos[$u]}" ]] || rm -f "$f"
  done
  unset vivos
  # los Match solo cambian al crear/borrar usuarios: recien ahi se recarga sshd
  if ! cmp -s "$match" "$CONF"; then
    old=$(mktemp); cp -f "$CONF" "$old" 2>/dev/null
    cp -f "$match" "$CONF"
    if sshd -t 2>/dev/null; then
      systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null
    else
      # config invalida: volver a la anterior para no romper el SSH
      if [[ -s "$old" ]]; then cp -f "$old" "$CONF"; else rm -f "$CONF"; fi
    fi
    rm -f "$old"
  fi
  rm -f "$match"
  sleep 10
done
UB
  # solo reescribe (y reinicia) si el script cambio, ej. tras actualizar el panel
  if ! cmp -s "$tmp" "$DIR/userbanner.sh"; then
    mv -f "$tmp" "$DIR/userbanner.sh"; chmod +x "$DIR/userbanner.sh"
    systemctl is-active --quiet jgx-userbanner 2>/dev/null && systemctl restart jgx-userbanner
  else
    rm -f "$tmp"
  fi
}

userbanner_mgr(){
  banner "INFO DE CUENTA EN EL BANNER"
  if systemctl is-active --quiet jgx-userbanner 2>/dev/null; then
    local col_st="${GREEN}ON${NC}"
    [[ "$(cat "$DIR/banner_color" 2>/dev/null)" == "off" ]] && col_st="${RED}OFF${NC}"
    echo -e "Estado actual: ${GREEN}ACTIVADO${NC}   Colores: $col_st\n"
    echo -e "${YELLOW}[1]${NC} Colores ON/OFF ${GRAY}(apagalo si la app muestra '<font ...>' como texto)${NC}"
    echo -e "${YELLOW}[2]${NC} Desactivar"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " r
    case $r in
      1) if [[ "$(cat "$DIR/banner_color" 2>/dev/null)" == "off" ]]; then
           echo "on" > "$DIR/banner_color"; echo -e "\n${GREEN}Colores activados.${NC}"
         else
           echo "off" > "$DIR/banner_color"; echo -e "\n${GREEN}Colores desactivados.${NC}"
         fi
         echo -e "${YELLOW}Se aplica en unos 10s; reconectate para verlo.${NC}";;
      2) systemctl disable --now jgx-userbanner >/dev/null 2>&1
         rm -f "$UB_CONF"; rm -rf "$DIR/banners"
         systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null
         echo -e "\n${GREEN}Desactivado. Se vuelve a mostrar solo el banner comun.${NC}";;
      *) return;;
    esac
  else
    echo -e "Estado actual: ${RED}DESACTIVADO${NC}\n"
    echo -e "Abajo de tu banner, cada usuario ve al conectar:"
    echo -e "  ${CYAN}Usuario: muchachos${NC}"
    echo -e "  ${CYAN}Dias restantes: 12 dias${NC}"
    echo -e "  ${CYAN}Conectados: 5/15${NC}"
    echo -e "\n${YELLOW}Se actualiza cada 10s. No aplica a Dropbear.${NC}\n"
    read -rp "Activar? [s/n]: " r
    if [[ "$r" =~ ^[sS]$ ]]; then
      userbanner_write
      cat > /etc/systemd/system/jgx-userbanner.service <<EOF
[Unit]
Description=JgXeinz banner por usuario
After=network.target
[Service]
ExecStart=/bin/bash $DIR/userbanner.sh
Restart=always
[Install]
WantedBy=multi-user.target
EOF
      systemctl daemon-reload
      systemctl enable --now jgx-userbanner >/dev/null 2>&1
      sleep 2
      if systemctl is-active --quiet jgx-userbanner && [[ -f "$UB_CONF" ]]; then
        echo -e "\n${GREEN}Activado.${NC} Reconectate desde HTTP Custom para verlo."
      else
        echo -e "\n${RED}No se pudo activar. Revisa: journalctl -u jgx-userbanner${NC}"
      fi
    fi
  fi
  pause
}

limiter(){
  banner "LIMITER (CONTROL DE CONEXIONES)"
  if systemctl is-active --quiet jgx-limiter 2>/dev/null; then
    echo -e "Estado actual: ${GREEN}ACTIVADO${NC}\n"
    read -rp "Desactivar el limiter? [s/n]: " r
    [[ "$r" =~ ^[sS]$ ]] && { systemctl disable --now jgx-limiter >/dev/null 2>&1; echo -e "\n${GREEN}Limiter desactivado${NC}"; }
  else
    echo -e "Estado actual: ${RED}DESACTIVADO${NC}\n"
    echo -e "Corta las conexiones que pasen el limite de cada usuario."
    echo -e "Revisa cada 5 segundos.\n"
    read -rp "Activar el limiter? [s/n]: " r
    if [[ "$r" =~ ^[sS]$ ]]; then
      cat > "$DIR/limiter.sh" <<'LIM'
#!/bin/bash
DB="/etc/jgxeinz/users.db"
while true; do
  if [[ -f "$DB" ]]; then
    while read -r user limite; do
      [[ -z "$user" ]] && continue
      [[ ! "$limite" =~ ^[0-9]+$ ]] && continue
      mapfile -t pids < <(ps -u "$user" -o pid=,comm= 2>/dev/null | grep -E 'sshd|dropbear' | awk '{print $1}')
      n=${#pids[@]}
      if (( n > limite )); then
        excess=$(( n - limite ))
        for ((i=0; i<excess; i++)); do
          kill -9 "${pids[$((n-1-i))]}" 2>/dev/null
        done
      fi
    done < "$DB"
  fi
  sleep 5
done
LIM
      chmod +x "$DIR/limiter.sh"
      cat > /etc/systemd/system/jgx-limiter.service <<EOF
[Unit]
Description=JgXeinz Limiter
After=network.target
[Service]
ExecStart=/bin/bash $DIR/limiter.sh
Restart=always
[Install]
WantedBy=multi-user.target
EOF
      systemctl daemon-reload
      systemctl enable --now jgx-limiter >/dev/null 2>&1
      systemctl is-active --quiet jgx-limiter \
        && echo -e "\n${GREEN}Limiter activado${NC}" \
        || echo -e "\n${RED}No se pudo activar${NC}"
    fi
  fi
  pause
}

actualizar(){
  banner "ACTUALIZAR PANEL"
  echo -e "${YELLOW}Descargando ultima version...${NC}"
  local sha base
  sha=$(curl -fsSL "https://api.github.com/repos/jtapiaa22/JgXeinz-VPN/commits/main?t=$(date +%s)" 2>/dev/null | grep -oE '[0-9a-f]{40}' | head -1)
  if [[ -n "$sha" ]]; then
    base="https://raw.githubusercontent.com/jtapiaa22/JgXeinz-VPN/$sha"
  else
    base="$REPO"
  fi
  if curl -H "Cache-Control: no-cache" -fsSL "$base/menu" -o /usr/bin/menu.new && [ -s /usr/bin/menu.new ]; then
    mv /usr/bin/menu.new /usr/bin/menu
    chmod +x /usr/bin/menu
    curl -H "Cache-Control: no-cache" -fsSL "$base/proxy.py" -o "$PROXY" 2>/dev/null
    echo -e "${GREEN}Panel actualizado. Reiniciando...${NC}"
    sleep 1
    exec /usr/bin/menu
  else
    rm -f /usr/bin/menu.new
    echo -e "${RED}No se pudo actualizar (repo privado o sin internet?).${NC}"; pause
  fi
}

# barra de uso: 16 celdas + porcentaje, color segun carga
bar(){
  local pct=${1:-0} width=16 filled b="" e="" col i
  [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
  [[ $pct -gt 100 ]] && pct=100
  filled=$(( pct * width / 100 ))
  for ((i=0;i<filled;i++)); do b+="█"; done
  for ((i=filled;i<width;i++)); do e+="░"; done
  if [[ $pct -ge 85 ]]; then col=$RED; elif [[ $pct -ge 60 ]]; then col=$YELLOW; else col=$GREEN; fi
  printf "${col}%s${GRAY}%s${NC} %3d%%" "$b" "$e" "$pct"
}

# indicador de servicio: punto verde si esta activo, gris si no
svc(){
  if [[ "$2" == 1 ]]; then echo -ne "${GREEN}●${NC} $1  "; else echo -ne "${GRAY}○ $1${NC}  "; fi
}

header(){
  local os up ip host cores users online hora exp
  os=$(. /etc/os-release 2>/dev/null; echo "$PRETTY_NAME")
  up=$(uptime -p 2>/dev/null | sed -E 's/^up //; s/ weeks?/w/; s/ days?/d/; s/ hours?/h/; s/ minutes?/m/; s/,//g')
  hora=$(date +%T)
  ip=$(get_ip)
  host=$(cat "$DIR/domain" 2>/dev/null)
  cores=$(nproc 2>/dev/null)
  local load ram_u ram_t ram_pct disk_u disk_t disk_pct cpu_pct
  load=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
  read -r ram_u ram_t < <(free -m | awk '/Mem/{print $3, $2}')
  ram_pct=$(( ram_t>0 ? ram_u*100/ram_t : 0 ))
  read -r disk_u disk_t < <(df -h / | awk 'NR==2{print $3, $2}')
  disk_pct=$(df / | awk 'NR==2{gsub("%","",$5); print $5}')
  cpu_pct=$(awk -v l="$load" -v c="$cores" 'BEGIN{if(c<1)c=1; p=l/c*100; if(p>100)p=100; printf "%d", p}')
  users=$(grep -c . "$DB")
  online=0; exp=0
  local now; now=$(date +%s)
  while read -r u _; do
    [[ -z "$u" ]] && continue
    [[ $(conexiones "$u") -gt 0 ]] && online=$((online+1))
    local ed; ed=$(chage -l "$u" 2>/dev/null | awk -F: '/Account expires/{print $2}' | sed 's/^ *//')
    [[ -z "$ed" || "$ed" == "never" ]] && continue
    local es; es=$(date -d "$ed" +%s 2>/dev/null) || continue
    [[ -n "$es" && "$es" -lt "$now" ]] && exp=$((exp+1))
  done < "$DB"
  local s_ws=0 s_drop=0 s_ovpn=0 s_ssl=0 s_bad=0 s_squid=0 s_lim=0
  [[ -n "$(systemctl list-units 'jgx-ws@*' --state=active --no-legend 2>/dev/null)" ]] && s_ws=1
  drop_on && s_drop=1
  systemctl is-active --quiet openvpn@server 2>/dev/null && s_ovpn=1
  systemctl is-active --quiet stunnel4 2>/dev/null && s_ssl=1
  pgrep -x badvpn-udpgw >/dev/null && s_bad=1
  systemctl is-active --quiet squid 2>/dev/null && s_squid=1
  systemctl is-active --quiet jgx-limiter 2>/dev/null && s_lim=1

  # dos columnas "etiqueta valor"; el padding va sobre texto plano
  printf " ${GRAY}%-7s${NC}%-27.27s${GRAY}%-8s${NC}%s\n" "OS" "$os" "Hora" "$hora"
  printf " ${GRAY}%-7s${NC}%-27.27s${GRAY}%-8s${NC}%s\n" "IP" "$ip" "Uptime" "$up"
  [[ -n "$host" ]] && printf " ${GRAY}%-7s${NC}${GREEN}%s${NC}\n" "Host" "$host"
  echo -e " ${GRAY}CPU    ${NC}$(bar "$cpu_pct")   ${GRAY}carga${NC} $load ${GRAY}/ ${cores} nucleo(s)${NC}"
  echo -e " ${GRAY}RAM    ${NC}$(bar "$ram_pct")   ${ram_u}M ${GRAY}/${NC} ${ram_t}M"
  echo -e " ${GRAY}Disco  ${NC}$(bar "$disk_pct")   ${disk_u} ${GRAY}/${NC} ${disk_t}"
  hr
  local exp_col=$GRAY; [[ $exp -gt 0 ]] && exp_col=$RED
  echo -e " ${GRAY}Usuarios${NC} ${WHITE}$users${NC}     ${GRAY}Online${NC} ${GREEN}$online${NC}     ${GRAY}Expirados${NC} ${exp_col}$exp${NC}"
  echo -e " $(svc SSH 1)$(svc WS $s_ws)$(svc DROP $s_drop)$(svc OVPN $s_ovpn)$(svc SSL $s_ssl)$(svc SQUID $s_squid)$(svc BAD $s_bad)$(svc LIM $s_lim)"
  hr
}

