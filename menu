#!/bin/bash
#==============================================================
#  JgXeinz VPN  -  Panel de administracion
#  Compatible: Ubuntu 22.04 / 24.04 / 26.04 - Debian 12 / 13
#  Repo: https://github.com/jtapiaa22/JgXeinz-VPN
#==============================================================

# ------------------- CONFIG (edita aca) -------------------
PANEL_NAME="JgXeinz VPN"
VERSION="1.1"
UDPGW_PORT="7300"
REPO="https://raw.githubusercontent.com/jtapiaa22/JgXeinz-VPN/main"
# ----------------------------------------------------------

DIR="/etc/jgxeinz"
DB="$DIR/users.db"
PROXY="$DIR/proxy.py"
BKP="$DIR/backup"
VPN_GROUP="$(cat "$DIR/group" 2>/dev/null)"; [[ -z "$VPN_GROUP" ]] && VPN_GROUP="jgxvpn"

RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'
BLUE='\033[1;34m'; CYAN='\033[1;36m'; WHITE='\033[1;37m'; NC='\033[0m'
GRAY='\033[0;90m'

# ancho de la interfaz; el separador se arma una sola vez
UI_W=60
HR="$(printf '%*s' "$UI_W" '' | sed 's/ /─/g')"
hr(){ echo -e "${BLUE}${HR}${NC}"; }

[[ $EUID -ne 0 ]] && { echo -e "${RED}Tenes que ejecutarlo como root (usa: sudo -i)${NC}"; exit 1; }
mkdir -p "$DIR" "$BKP"; touch "$DB"
getent group "$VPN_GROUP" >/dev/null 2>&1 || groupadd "$VPN_GROUP"

pause(){ echo ""; read -rp "$(echo -e "${CYAN}Presiona ENTER para volver...${NC}")" _; }

# IP cacheada: evita un curl en cada redibujado (monitor/header)
get_ip(){
  local cache="$DIR/ip" ip now mtime
  now=$(date +%s)
  if [[ -f "$cache" ]]; then
    mtime=$(stat -c %Y "$cache" 2>/dev/null || echo 0)
    if (( now - mtime < 3600 )); then cat "$cache"; return; fi
  fi
  ip=$(curl -s --max-time 5 https://ipv4.icanhazip.com 2>/dev/null || hostname -I | awk '{print $1}')
  echo "$ip" > "$cache"
  echo "$ip"
}

# nombre de usuario valido para linux (sin inyectar en sed/useradd)
valid_user(){ [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }

# nombres de cuentas del sistema que NUNCA se tocan (root, admin de debian, ubuntu de aws, etc.)
is_system_user(){
  case "$1" in
    root|ubuntu|admin|debian|ec2-user|nobody|daemon|bin|sys|sync|systemd*|_*) return 0;;
  esac
  return 1
}

# todos los usuarios gestionables: UID >= 1000 reales, menos los de sistema.
# incluye los del grupo jgxvpn y tambien los viejos que todavia no se importaron.
all_panel_users(){
  awk -F: '$3>=1000 && $3<65534 {print $1}' /etc/passwd | while read -r u; do
    is_system_user "$u" && continue
    echo "$u"
  done
}

# cuenta conexiones activas de un usuario (sshd + dropbear)
conexiones(){ ps -u "$1" 2>/dev/null | grep -cE 'sshd|dropbear'; }

# quien escucha en un puerto TCP (vacio si esta libre). python3 es el proxy WS del panel.
quien_usa_puerto(){
  local p; p=$(ss -tlnp "sport = :$1" 2>/dev/null | grep -oP 'users:\(\("\K[^"]+' | head -1)
  [[ "$p" == python3 ]] && p="WebSocket del panel (opcion 05)"
  echo "$p"
}

# barra de titulo: nombre + version a la izquierda, seccion actual a la derecha.
# banner "TITULO" -> pantalla de una seccion (deja una linea libre abajo,
# salvo que se pase un 2do argumento: banner "TITULO" pegado)
# logo compacto de 3 lineas (55 columnas). Si cambias PANEL_NAME,
# este dibujo no cambia solo: hay que redibujarlo a mano.
LOGO=(
"   █ ▄▀▀▀ ▀▄ ▄▀ █▀▀▀ ▀█▀ █▄  █ ▀▀▀█▀    █   █ █▀▀▄ █▄  █"
"▄  █ █ ▀█  ▄▀▄  █▀▀   █  █ ▀▄█  ▄▀      ▀▄ ▄▀ █▀▀  █ ▀▄█"
" ▀▀   ▀▀▀ ▀   ▀ ▀▀▀▀ ▀▀▀ ▀   ▀ ▀▀▀▀▀      ▀   ▀    ▀   ▀"
)

banner(){
  clear
  if [[ -z "$1" ]]; then
    # pantalla principal: logo + subtitulo con la version a la derecha
    local sub="PANEL DE ADMINISTRACION" ver="v$VERSION"
    hr
    local l; for l in "${LOGO[@]}"; do echo -e "  ${CYAN}${l}${NC}"; done
    printf " ${GRAY}%s%*s%s${NC}\n" "$sub" $(( UI_W - ${#sub} - ${#ver} - 2 )) "" "$ver"
    hr
    return
  fi
  local ver="v$VERSION" right="$1" pad
  pad=$(( UI_W - ${#PANEL_NAME} - ${#ver} - ${#right} - 3 ))
  (( pad < 1 )) && pad=1
  hr
  printf " ${WHITE}%s${NC} ${GRAY}%s${NC}%*s${CYAN}%s${NC}\n" "$PANEL_NAME" "$ver" "$pad" "" "$right"
  hr
  [[ -n "$1" && -z "$2" ]] && echo ""
}

# --------------------------------------------------------------
#  GESTION DE USUARIOS
# --------------------------------------------------------------
gen_cuenta(){
  # args: user pass exp limite
  local user="$1" pass="$2" exp="$3" limite="$4"
  local ip sshp dropp wsp ovpnp sslp badp dias
  ip=$(get_ip)
  local host; host=$(cat "$DIR/domain" 2>/dev/null); [[ -z "$host" ]] && host="$ip"
  sshp=$(grep -iE '^[[:space:]]*port' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | paste -sd, -)
  [[ -z "$sshp" ]] && sshp="22"
  drop_on && dropp=$(drop_port)
  wsp=$(systemctl list-units 'jgx-ws@*' --state=active --no-legend 2>/dev/null | grep -oP 'jgx-ws@\K[0-9]+' | paste -sd, -)
  systemctl is-active --quiet openvpn@server 2>/dev/null && ovpnp=$(grep -i '^port' /etc/openvpn/server.conf 2>/dev/null | awk '{print $2}')
  systemctl is-active --quiet stunnel4 2>/dev/null && sslp=$(grep -i '^accept' /etc/stunnel/stunnel.conf 2>/dev/null | grep -oP '[0-9]+' | paste -sd, -)
  badp=$(systemctl list-units 'jgx-badvpn@*' --state=active --no-legend 2>/dev/null | grep -oP 'jgx-badvpn@\K[0-9]+' | paste -sd, -)
  if [[ -n "$exp" && "$exp" != "nunca" ]]; then
    dias=$(( ( $(date -d "$exp" +%s 2>/dev/null) - $(date +%s) ) / 86400 ))
  fi
  mkdir -p "$DIR/cuentas"
  local f="$DIR/cuentas/$user.txt"
  {
    echo "=============================================="
    echo "         CUENTA CREADA EXITOSAMENTE"
    echo "=============================================="
    echo " Tipo        : NORMAL"
    echo " Usuario/ID  : $user"
    echo " Contrasena  : $pass"
    echo " Expira      : $exp${dias:+ ($dias dias)}"
    echo " Limite IP   : ${limite:-1}"
    echo "----------------------------------------------"
    echo " Host        : $host"
    [[ -n "$sshp" ]]  && echo " Puertos SSH : $sshp"
    [[ -n "$dropp" ]] && echo " Dropbear    : $dropp"
    [[ -n "$wsp" ]]   && echo " Websocket   : $wsp"
    [[ -n "$ovpnp" ]] && echo " OpenVPN     : $ovpnp"
    [[ -n "$sslp" ]]  && echo " SSL Tunnel  : $sslp"
    [[ -n "$badp" ]]  && echo " BadVPN      : $badp"
    echo "----------------------------------------------"
    echo " HTTP CUSTOM :"
    for p in $(echo "$sshp,$wsp,$sslp" | tr ',' '\n' | grep -v '^$' | sort -un); do
      echo "   $host:$p@$user:$pass"
    done
    if [[ -n "$badp" ]]; then
      echo "----------------------------------------------"
      echo " BADVPN (voz/UDP) : va por dentro del tunel SSH."
      echo "   En HTTP Custom activa 'UDPGW' con el puerto $badp."
    fi
    echo "=============================================="
  } | tee "$f"
  chmod 600 "$f" 2>/dev/null
  echo -e "\n${YELLOW}(Guardado; se vuelve a ver con la opcion 16)${NC}"
}

# agrega la regla de medicion de trafico para un usuario (idempotente)
add_traffic_rule(){
  local uid; uid=$(id -u "$1" 2>/dev/null) || return
  iptables -C OUTPUT -m owner --uid-owner "$uid" 2>/dev/null || iptables -A OUTPUT -m owner --uid-owner "$uid"
  netfilter-persistent save >/dev/null 2>&1
}

datos_cuenta(){
  banner "DATOS DE CUENTA"
  mapfile -t us < <(ls -1 "$DIR/cuentas"/*.txt 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.txt$//')
  [[ ${#us[@]} -eq 0 ]] && { echo -e "${RED}No hay cuentas guardadas (se guardan al crear usuarios).${NC}"; pause; return; }
  local i=1; for u in "${us[@]}"; do echo -e "${YELLOW}[$i]${NC} $u"; ((i++)); done
  echo ""; read -rp "Numero o nombre: " sel
  local user
  if [[ "$sel" =~ ^[0-9]+$ ]]; then user="${us[$((sel-1))]}"; else user="$sel"; fi
  [[ -z "$user" || ! -f "$DIR/cuentas/$user.txt" ]] && { echo -e "${RED}No encontrado${NC}"; pause; return; }
  echo ""; cat "$DIR/cuentas/$user.txt"
  pause
}

crear_usuario(){
  banner "CREAR USUARIO"
  read -rp "Nombre de usuario: " user
  [[ -z "$user" ]] && { echo -e "${RED}Usuario vacio${NC}"; pause; return; }
  valid_user "$user" || { echo -e "${RED}Nombre invalido. Usa minusculas, numeros, '-' o '_' (sin espacios).${NC}"; pause; return; }
  id "$user" &>/dev/null && { echo -e "${RED}Ese usuario ya existe${NC}"; pause; return; }
  read -rp "Contrasena: " pass
  [[ -z "$pass" ]] && { echo -e "${RED}Contrasena vacia${NC}"; pause; return; }
  read -rp "Dias de validez: " dias
  [[ ! "$dias" =~ ^[0-9]+$ ]] && { echo -e "${RED}Dias invalidos${NC}"; pause; return; }
  read -rp "Limite de conexiones: " limite
  [[ ! "$limite" =~ ^[0-9]+$ ]] && limite=1
  local exp; exp=$(date -d "+$dias days" +%Y-%m-%d)
  if ! useradd -M -s /bin/false -e "$exp" -G "$VPN_GROUP" "$user"; then
    echo -e "\n${RED}No se pudo crear el usuario (useradd fallo).${NC}"; pause; return
  fi
  echo "$user:$pass" | chpasswd
  sed -i "/^$user /d" "$DB"
  echo "$user $limite" >> "$DB"
  add_traffic_rule "$user"
  echo ""
  echo -e "${GREEN}Usuario creado con exito${NC}\n"
  gen_cuenta "$user" "$pass" "$exp" "$limite"
  pause
}

crear_teste(){
  banner "USUARIO DE PRUEBA"
  read -rp "Minutos de validez [por defecto 30]: " mins
  [[ ! "$mins" =~ ^[0-9]+$ ]] && mins=30
  local user pass; user="test$(shuf -i 100-999 -n1)"; pass="$(shuf -i 1000-9999 -n1)"
  if ! useradd -M -s /bin/false -G "$VPN_GROUP" "$user"; then
    echo -e "${RED}No se pudo crear el usuario de prueba${NC}"; pause; return
  fi
  echo "$user:$pass" | chpasswd
  sed -i "/^$user /d" "$DB"
  echo "$user 1" >> "$DB"
  add_traffic_rule "$user"
  # borrado automatico al vencer: corta la sesion y limpia la DB.
  # el --on-active es transitorio (no sobrevive reboot); el barrido diario
  # de 'remover_expirados' lo cubre como red de seguridad.
  systemd-run --on-active="${mins}min" /bin/bash -c "pkill -u $user 2>/dev/null; userdel --force $user 2>/dev/null; sed -i '/^$user /d' $DB" >/dev/null 2>&1
  echo ""
  echo -e "${GREEN}Usuario de prueba creado${NC}"
  echo -e "${WHITE}----------------------------------${NC}"
  echo -e " Usuario : ${GREEN}$user${NC}"
  echo -e " Clave   : ${GREEN}$pass${NC}"
  echo -e " Dura    : ${GREEN}$mins minutos${NC}"
  echo -e " IP      : ${GREEN}$(get_ip)${NC}"
  echo -e "${WHITE}----------------------------------${NC}"
  pause
}

remover_usuario(){
  banner "REMOVER USUARIO"
  mapfile -t users < <(all_panel_users)
  [[ ${#users[@]} -eq 0 ]] && { echo -e "${RED}No hay usuarios${NC}"; pause; return; }
  local i=1
  for u in "${users[@]}"; do
    if grep -q "^$u " "$DB"; then
      echo -e "${YELLOW}[$i]${NC} $u"
    else
      echo -e "${YELLOW}[$i]${NC} $u ${CYAN}(ext)${NC}"
    fi
    ((i++))
  done
  echo ""; read -rp "Numero o nombre a remover: " sel
  local user
  if [[ "$sel" =~ ^[0-9]+$ ]]; then user="${users[$((sel-1))]}"; else user="$sel"; fi
  [[ -z "$user" ]] && { echo -e "${RED}Seleccion invalida${NC}"; pause; return; }
  if is_system_user "$user"; then
    echo -e "${RED}Ese usuario es del sistema y no se puede borrar${NC}"; pause; return
  fi
  pkill -u "$user" 2>/dev/null
  userdel --force "$user" 2>/dev/null
  sed -i "/^$user /d" "$DB"
  rm -f "$DIR/cuentas/$user.txt" 2>/dev/null
  echo -e "\n${GREEN}Usuario $user eliminado${NC}"; pause
}

monitor_online(){
  while true; do
    banner "MONITOR EN VIVO" pegado
    header
    printf "${WHITE} %-15s %-9s %-7s %-8s${NC}\n" "USUARIO" "ESTADO" "CONEX" "DATOS"
    hr
    local ipt on=0; ipt=$(iptables -L OUTPUT -v -n -x 2>/dev/null)
    while read -r user; do
      [[ -z "$user" ]] && continue
      local limite n uid mb
      limite=$(awk -v u="$user" '$1==u{print $2}' "$DB"); [[ -z "$limite" ]] && limite="-"
      n=$(conexiones "$user")
      uid=$(id -u "$user" 2>/dev/null)
      mb=$(echo "$ipt" | awk -v p="owner UID match $uid" '$0 ~ p {s+=$2} END{printf "%d", (s+0)/1048576}')
      local tag=""
      grep -q "^$user " "$DB" || tag=" ${CYAN}(ext)${NC}"
      if [[ "$n" -gt 0 ]]; then
        printf " ${GREEN}%-15s %-9s %-7s %-8s${NC}%b\n" "$user" "ONLINE" "$n/$limite" "${mb}MB" "$tag"
        on=$((on+1))
      else
        printf " %-15s ${RED}%-9s${NC} %-7s %-8s%b\n" "$user" "offline" "0/$limite" "${mb}MB" "$tag"
      fi
    done < <(all_panel_users)
    hr
    echo -e " ${WHITE}Online: ${GREEN}$on${NC}   ${YELLOW}(se actualiza cada 3s - apreta 'q' para salir)${NC}"
    read -t 3 -n 1 -s k
    [[ "$k" == "q" ]] && break
  done
}

# regenera el archivo cuentas/ tras cambiar pass/fecha/limite
regen_cuenta(){
  local user="$1"
  [[ -f "$DIR/cuentas/$user.txt" ]] || return
  local pass exp limite
  pass=$(grep -i 'Contrasena' "$DIR/cuentas/$user.txt" | head -1 | cut -d: -f2- | xargs)
  limite=$(awk -v u="$user" '$1==u{print $2}' "$DB")
  exp=$(chage -l "$user" 2>/dev/null | grep -i "account expires" | cut -d: -f2- | xargs)
  [[ "$exp" == "never" || -z "$exp" ]] && exp="nunca" || exp=$(date -d "$exp" +%Y-%m-%d 2>/dev/null)
  gen_cuenta "$user" "$pass" "$exp" "$limite" >/dev/null
}

cambiar_fecha(){
  banner "CAMBIAR FECHA DE VENCIMIENTO"
  read -rp "Usuario: " user
  id "$user" &>/dev/null || { echo -e "${RED}Ese usuario no existe${NC}"; pause; return; }
  read -rp "Nuevos dias de validez: " dias
  [[ ! "$dias" =~ ^[0-9]+$ ]] && { echo -e "${RED}Dias invalidos${NC}"; pause; return; }
  local exp; exp=$(date -d "+$dias days" +%Y-%m-%d)
  chage -E "$exp" "$user"
  regen_cuenta "$user"
  echo -e "\n${GREEN}Nueva fecha de vencimiento: $exp${NC}"; pause
}

renovar_usuario(){
  banner "RENOVAR USUARIO (SUMAR DIAS)"
  read -rp "Usuario: " user
  id "$user" &>/dev/null || { echo -e "${RED}Ese usuario no existe${NC}"; pause; return; }
  read -rp "Dias a sumar: " dias
  [[ ! "$dias" =~ ^[0-9]+$ ]] && { echo -e "${RED}Dias invalidos${NC}"; pause; return; }
  local actual base exp
  actual=$(chage -l "$user" 2>/dev/null | grep -i "account expires" | cut -d: -f2- | xargs)
  if [[ "$actual" == "never" || -z "$actual" ]]; then
    base=$(date +%s)
  else
    base=$(date -d "$actual" +%s 2>/dev/null)
    # si ya vencio, suma desde hoy
    (( base < $(date +%s) )) && base=$(date +%s)
  fi
  exp=$(date -d "@$(( base + dias*86400 ))" +%Y-%m-%d)
  chage -E "$exp" "$user"
  regen_cuenta "$user"
  echo -e "\n${GREEN}Nuevo vencimiento de $user: $exp${NC}"; pause
}

cambiar_limite(){
  banner "CAMBIAR LIMITE DE CONEXIONES"
  read -rp "Usuario: " user
  grep -q "^$user " "$DB" || { echo -e "${RED}Ese usuario no esta en la base${NC}"; pause; return; }
  read -rp "Nuevo limite: " limite
  [[ ! "$limite" =~ ^[0-9]+$ ]] && { echo -e "${RED}Limite invalido${NC}"; pause; return; }
  sed -i "/^$user /d" "$DB"
  echo "$user $limite" >> "$DB"
  regen_cuenta "$user"
  echo -e "\n${GREEN}Limite de $user ahora es $limite${NC}"
  echo -e "${YELLOW}(El corte real lo aplica el Limiter, opcion 14)${NC}"; pause
}

cambiar_senha(){
  banner "CAMBIAR CONTRASENA"
  read -rp "Usuario: " user
  id "$user" &>/dev/null || { echo -e "${RED}Ese usuario no existe${NC}"; pause; return; }
  read -rp "Nueva contrasena: " pass
  [[ -z "$pass" ]] && { echo -e "${RED}Contrasena vacia${NC}"; pause; return; }
  echo "$user:$pass" | chpasswd
  regen_cuenta "$user"
  echo -e "\n${GREEN}Contrasena de $user actualizada${NC}"; pause
}

remover_expirados(){
  banner "REMOVER EXPIRADOS"
  local hoy n=0; hoy=$(date +%s)
  while read -r user _; do
    [[ -z "$user" ]] && continue
    local exp exp_s; exp=$(chage -l "$user" 2>/dev/null | grep -i "account expires" | cut -d: -f2- | xargs)
    [[ "$exp" == "never" || -z "$exp" ]] && continue
    exp_s=$(date -d "$exp" +%s 2>/dev/null) || continue
    if (( exp_s < hoy )); then
      pkill -u "$user" 2>/dev/null
      userdel --force "$user" 2>/dev/null
      sed -i "/^$user /d" "$DB"
      rm -f "$DIR/cuentas/$user.txt" 2>/dev/null
      echo -e "${RED}Eliminado: $user${NC}"; ((n++))
    fi
  done < "$DB"
  echo -e "\n${GREEN}$n usuario(s) expirado(s) eliminado(s)${NC}"; pause
}

reporte(){
  banner "REPORTE DE USUARIOS"
  printf "${WHITE}%-16s %-12s %-7s %-6s${NC}\n" "USUARIO" "VENCE" "DIAS" "LIMITE"
  echo "-------------------------------------------"
  local hoy; hoy=$(date +%s)
  while read -r user limite; do
    [[ -z "$user" ]] && continue
    local exp exp_s dias
    exp=$(chage -l "$user" 2>/dev/null | grep -i "account expires" | cut -d: -f2- | xargs)
    if [[ "$exp" == "never" || -z "$exp" ]]; then
      dias="-"; exp="nunca"
    else
      exp_s=$(date -d "$exp" +%s 2>/dev/null)
      dias=$(( (exp_s - hoy) / 86400 ))
    fi
    printf "%-16s %-12s %-7s %-6s\n" "$user" "$exp" "$dias" "$limite"
  done < "$DB"
  pause
}

# --------------------------------------------------------------
#  MODO DE CONEXION
# --------------------------------------------------------------
ws_on(){
  local p="$1"
  cat > /etc/systemd/system/jgx-ws@.service <<EOF
[Unit]
Description=JgXeinz WebSocket proxy %i
After=network.target
[Service]
ExecStart=/usr/bin/python3 $PROXY %i
Restart=always
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl reset-failed jgx-ws@"$p" 2>/dev/null
  systemctl enable --now jgx-ws@"$p" >/dev/null 2>&1
  sleep 1
  if ss -tlnp 2>/dev/null | grep -q ":$p "; then
    echo -e "${GREEN}WebSocket activo en el puerto $p${NC}"
    echo -e "${YELLOW}Acordate de abrir el puerto $p en el grupo de seguridad de AWS${NC}"
  else
    echo -e "${RED}No se pudo activar. Puede que el puerto $p ya este en uso.${NC}"
  fi
}

badvpn_on(){
  local p="$1"
  local bin; bin=$(command -v badvpn-udpgw)
  [[ -z "$bin" ]] && { echo -e "${RED}badvpn-udpgw no esta instalado (reinstala el panel o compilalo).${NC}"; return; }
  # migrar del servicio viejo unico, si existia
  systemctl disable --now jgx-badvpn >/dev/null 2>&1
  rm -f /etc/systemd/system/jgx-badvpn.service 2>/dev/null
  cat > /etc/systemd/system/jgx-badvpn@.service <<EOF
[Unit]
Description=JgXeinz BadVPN UDPGW %i
After=network.target
[Service]
ExecStart=$bin --listen-addr 127.0.0.1:%i --max-clients 500 --max-connections-for-client 10
Restart=always
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now jgx-badvpn@"$p" >/dev/null 2>&1
  sleep 1
  systemctl is-active --quiet jgx-badvpn@"$p" \
    && echo -e "${GREEN}BadVPN activo en 127.0.0.1:$p${NC}" \
    || echo -e "${RED}No se pudo activar en $p${NC}"
}

ssh_ports_mgr(){
  while true; do
    banner "OPENSSH"
    echo -e " Puertos SSH: ${GREEN}$(grep -iE '^[[:space:]]*port' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | xargs)${NC}\n"
    echo -e "${YELLOW}[1]${NC} Agregar puerto"
    echo -e "${YELLOW}[2]${NC} Quitar puerto"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " o
    case $o in
      1) read -rp "Puerto a agregar: " p
         if [[ "$p" =~ ^[0-9]+$ ]]; then
           # garantizamos que el 22 quede explicito antes de sumar otro,
           # para no quedarnos sin el puerto por defecto
           grep -qE '^[[:space:]]*Port[[:space:]]+22([[:space:]]|$)' /etc/ssh/sshd_config || echo "Port 22" >> /etc/ssh/sshd_config
           grep -qE "^[[:space:]]*Port[[:space:]]+$p([[:space:]]|\$)" /etc/ssh/sshd_config || echo "Port $p" >> /etc/ssh/sshd_config
           systemctl restart ssh.socket 2>/dev/null
           systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
           echo -e "${GREEN}Agregado. Abrilo en AWS.${NC}"
         else echo -e "${RED}Invalido${NC}"; fi; pause;;
      2) read -rp "Puerto a quitar: " p
         if [[ "$p" == "22" ]]; then echo -e "${RED}El 22 no se quita (es tu acceso de respaldo).${NC}"; pause; continue; fi
         sed -i "/^[[:space:]]*Port[[:space:]]\+$p\$/d" /etc/ssh/sshd_config
         systemctl restart ssh.socket 2>/dev/null
         systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
         echo -e "${GREEN}Listo${NC}"; pause;;
      0) break;;
    esac
  done
}

ws_mgr(){
