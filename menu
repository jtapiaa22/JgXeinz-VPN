}

limiter(){
  banner; echo -e "${WHITE} LIMITER (control de conexiones)${NC}\n"
  if systemctl is-active --quiet jgx-limiter 2>/dev/null; then
    echo -e "Estado actual: ${GREEN}ACTIVADO${NC}\n"
    read -rp "Desactivar el limiter? [s/n]: " r
    [[ "$r" =~ ^[sS]$ ]] && { systemctl disable --now jgx-limiter >/dev/null 2>&1; echo -e "\n${GREEN}Limiter desactivado${NC}"; }
  else
    echo -e "Estado actual: ${RED}DESACTIVADO${NC}\n"
    echo -e "Corta las conexiones que pasen el limite de cada usuario."
    echo -e "Revisa cada 5 segundos.\n"
    read -rp "Activar el limiter? [s/n]: " r
    if [[ "$r" =~ ^[sS]$ ]]; then
      cat > "$DIR/limiter.sh" <<'LIM'
#!/bin/bash
DB="/etc/jgxeinz/users.db"
while true; do
  if [[ -f "$DB" ]]; then
    while read -r user limite; do
      [[ -z "$user" ]] && continue
      [[ ! "$limite" =~ ^[0-9]+$ ]] && continue
      mapfile -t pids < <(ps -u "$user" -o pid=,comm= 2>/dev/null | grep -E 'sshd' | awk '{print $1}')
      n=${#pids[@]}
      if (( n > limite )); then
        excess=$(( n - limite ))
        for ((i=0; i<excess; i++)); do
          kill -9 "${pids[$((n-1-i))]}" 2>/dev/null
        done
      fi
    done < "$DB"
  fi
  sleep 5
done
LIM
      chmod +x "$DIR/limiter.sh"
      cat > /etc/systemd/system/jgx-limiter.service <<EOF
[Unit]
Description=JgXeinz Limiter
After=network.target
[Service]
ExecStart=/bin/bash $DIR/limiter.sh
Restart=always
[Install]
WantedBy=multi-user.target
EOF
      systemctl daemon-reload
      systemctl enable --now jgx-limiter >/dev/null 2>&1
      systemctl is-active --quiet jgx-limiter \
        && echo -e "\n${GREEN}Limiter activado${NC}" \
        || echo -e "\n${RED}No se pudo activar${NC}"
    fi
  fi
  pause
}

actualizar(){
  banner; echo -e "${WHITE} ACTUALIZAR PANEL${NC}\n"
  echo -e "${YELLOW}Descargando ultima version...${NC}"
  local sha base
  sha=$(curl -fsSL "https://api.github.com/repos/jtapiaa22/JgXeinz-VPN/commits/main?t=$(date +%s)" 2>/dev/null | grep -oE '[0-9a-f]{40}' | head -1)
  if [[ -n "$sha" ]]; then
    base="https://raw.githubusercontent.com/jtapiaa22/JgXeinz-VPN/$sha"
  else
    base="$REPO"
  fi
  if curl -H "Cache-Control: no-cache" -fsSL "$base/menu" -o /usr/bin/menu.new && [ -s /usr/bin/menu.new ]; then
    mv /usr/bin/menu.new /usr/bin/menu
    chmod +x /usr/bin/menu
    curl -H "Cache-Control: no-cache" -fsSL "$base/proxy.py" -o "$PROXY" 2>/dev/null
    echo -e "${GREEN}Panel actualizado. Reiniciando...${NC}"
    sleep 1
    exec /usr/bin/menu
  else
    rm -f /usr/bin/menu.new
    echo -e "${RED}No se pudo actualizar (repo privado o sin internet?).${NC}"; pause
  fi
}

bar(){
  local pct=${1:-0} width=16 filled empty b="" e="" col i
  [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
  [[ $pct -gt 100 ]] && pct=100
  filled=$(( pct * width / 100 )); empty=$(( width - filled ))
  for ((i=0;i<filled;i++)); do b+="|"; done
  for ((i=0;i<empty;i++)); do e+="-"; done
  if [[ $pct -ge 85 ]]; then col=$RED; elif [[ $pct -ge 60 ]]; then col=$YELLOW; else col=$GREEN; fi
  echo -ne "${col}[${b}${e}]${NC} ${pct}%"
}

header(){
  local os up ip host cores users online
  os=$(. /etc/os-release 2>/dev/null; echo "$PRETTY_NAME")
  up=$(uptime -p 2>/dev/null | sed 's/^up //')
  ip=$(get_ip)
  host=$(cat "$DIR/domain" 2>/dev/null)
  cores=$(nproc 2>/dev/null)
  local load ram_u ram_t ram_pct disk_u disk_t disk_pct cpu_pct
  load=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
  read -r ram_u ram_t < <(free -m | awk '/Mem/{print $3, $2}')
  ram_pct=$(( ram_t>0 ? ram_u*100/ram_t : 0 ))
  read -r disk_u disk_t < <(df -h / | awk 'NR==2{print $3, $2}')
  disk_pct=$(df / | awk 'NR==2{gsub("%","",$5); print $5}')
  cpu_pct=$(awk -v l="$load" -v c="$cores" 'BEGIN{if(c<1)c=1; p=l/c*100; if(p>100)p=100; printf "%d", p}')
  users=$(grep -c . "$DB")
  online=0
  while read -r u _; do
    [[ -z "$u" ]] && continue
    [[ $(ps -u "$u" 2>/dev/null | grep -c sshd) -gt 0 ]] && online=$((online+1))
  done < "$DB"
  local s_ws s_drop s_ovpn s_ssl s_bad s_squid s_lim
  [[ -n "$(systemctl list-units 'jgx-ws@*' --state=active --no-legend 2>/dev/null)" ]] && s_ws="${GREEN}ON${NC}" || s_ws="${RED}OFF${NC}"
  systemctl is-active --quiet dropbear 2>/dev/null && s_drop="${GREEN}ON${NC}" || s_drop="${RED}OFF${NC}"
  systemctl is-active --quiet openvpn@server 2>/dev/null && s_ovpn="${GREEN}ON${NC}" || s_ovpn="${RED}OFF${NC}"
  systemctl is-active --quiet stunnel4 2>/dev/null && s_ssl="${GREEN}ON${NC}" || s_ssl="${RED}OFF${NC}"
  pgrep -x badvpn-udpgw >/dev/null && s_bad="${GREEN}ON${NC}" || s_bad="${RED}OFF${NC}"
  systemctl is-active --quiet squid 2>/dev/null && s_squid="${GREEN}ON${NC}" || s_squid="${RED}OFF${NC}"
  systemctl is-active --quiet jgx-limiter 2>/dev/null && s_lim="${GREEN}ON${NC}" || s_lim="${RED}OFF${NC}"
  echo -e "${BLUE}-----------------------------------------------${NC}"
  echo -e " ${WHITE}OS   :${NC} $os"
  echo -e " ${WHITE}UP   :${NC} $up"
  [[ -n "$host" ]] && echo -e " ${WHITE}IP   :${NC} $ip ${WHITE}/${NC} ${GREEN}$host${NC}" || echo -e " ${WHITE}IP   :${NC} $ip"
  echo -e " ${WHITE}CPU  :${NC} $(bar "$cpu_pct")  carga $load / ${cores}c"
  echo -e " ${WHITE}RAM  :${NC} $(bar "$ram_pct")  ${ram_u}M/${ram_t}M"
  echo -e " ${WHITE}DISCO:${NC} $(bar "$disk_pct")  ${disk_u}/${disk_t}"
  echo -e "${BLUE}-----------------------------------------------${NC}"
  echo -e " ${WHITE}SERV :${NC} SSH:${GREEN}ON${NC} WS:$s_ws DROP:$s_drop OVPN:$s_ovpn SSL:$s_ssl SQUID:$s_squid BAD:$s_bad"
  echo -e " ${WHITE}CTAS :${NC} total:${GREEN}$users${NC}  online:${GREEN}$online${NC}  limiter:$s_lim"
  echo -e "${BLUE}-----------------------------------------------${NC}"
}

# --------------------------------------------------------------
#  MENU PRINCIPAL
# --------------------------------------------------------------
while true; do
  banner
  systemctl is-active --quiet jgx-limiter 2>/dev/null && lim_st="${GREEN}ON${NC}" || lim_st="${RED}OFF${NC}"
  header
  echo -e "${YELLOW}[01]${NC} Crear usuario       ${YELLOW}[08]${NC} Remover expirados"
  echo -e "${YELLOW}[02]${NC} Usuario de prueba   ${YELLOW}[09]${NC} Reporte de usuarios"
  echo -e "${YELLOW}[03]${NC} Remover usuario     ${YELLOW}[10]${NC} Modo de conexion"
  echo -e "${YELLOW}[04]${NC} Monitor online      ${YELLOW}[11]${NC} Info del VPS"
  echo -e "${YELLOW}[05]${NC} Cambiar fecha       ${YELLOW}[12]${NC} Backup"
  echo -e "${YELLOW}[06]${NC} Cambiar limite      ${YELLOW}[13]${NC} Actualizar panel"
  echo -e "${YELLOW}[07]${NC} Cambiar contrasena  ${YELLOW}[14]${NC} Limiter $lim_st"
  echo -e "                         ${YELLOW}[15]${NC} Herramientas"
  echo -e "                         ${YELLOW}[16]${NC} Datos de cuenta"
  echo -e "                         ${YELLOW}[00]${NC} Salir"
  echo -e "${BLUE}-----------------------------------------------${NC}"
  read -rp "Opcion: " opt
  case $opt in
    1|01) crear_usuario;;
    2|02) crear_teste;;
    3|03) remover_usuario;;
    4|04) monitor_online;;
    5|05) cambiar_fecha;;
    6|06) cambiar_limite;;
    7|07) cambiar_senha;;
    8|08) remover_expirados;;
    9|09) reporte;;
    10) modo_conexion;;
    11) info_vps;;
    12) backup;;
    13) actualizar;;
    14) limiter;;
    15) herramientas;;
    16) datos_cuenta;;
    0|00) clear; exit 0;;
    *) echo -e "${RED}Opcion invalida${NC}"; sleep 1;;
  esac
done
