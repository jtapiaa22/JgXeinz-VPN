}

modo_conexion(){
  while true; do
    banner
    local st_ssh st_squid st_drop st_ovpn st_ws st_ssl st_sslh st_bad
    st_ssh="${GREEN}ON${NC}"
    systemctl is-active --quiet squid 2>/dev/null && st_squid="${GREEN}ON${NC}" || st_squid="${RED}OFF${NC}"
    systemctl is-active --quiet dropbear 2>/dev/null && st_drop="${GREEN}ON${NC}" || st_drop="${RED}OFF${NC}"
    systemctl is-active --quiet openvpn@server 2>/dev/null && st_ovpn="${GREEN}ON${NC}" || st_ovpn="${RED}OFF${NC}"
    [[ -n "$(systemctl list-units 'jgx-ws@*' --state=active --no-legend 2>/dev/null)" ]] && st_ws="${GREEN}ON${NC}" || st_ws="${RED}OFF${NC}"
    systemctl is-active --quiet stunnel4 2>/dev/null && st_ssl="${GREEN}ON${NC}" || st_ssl="${RED}OFF${NC}"
    systemctl is-active --quiet sslh 2>/dev/null && st_sslh="${GREEN}ON${NC}" || st_sslh="${RED}OFF${NC}"
    pgrep -x badvpn-udpgw >/dev/null && st_bad="${GREEN}ON${NC}" || st_bad="${RED}OFF${NC}"
    echo -e "${WHITE} MODO DE CONEXION${NC}"
    echo -e " SSH: ${GREEN}$(grep -i '^port' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | xargs)${NC}"
    echo -e "${BLUE}-----------------------------------------------${NC}"
    echo -e "${YELLOW}[01]${NC} OPENSSH             $st_ssh"
    echo -e "${YELLOW}[02]${NC} SQUID PROXY         $st_squid"
    echo -e "${YELLOW}[03]${NC} DROPBEAR            $st_drop"
    echo -e "${YELLOW}[04]${NC} OPENVPN             $st_ovpn"
    echo -e "${YELLOW}[05]${NC} PROXY SOCKS / WS    $st_ws"
    echo -e "${YELLOW}[06]${NC} SSL TUNNEL          $st_ssl"
    echo -e "${YELLOW}[07]${NC} SSLH MULTIPLEX      $st_sslh"
    echo -e "${YELLOW}[08]${NC} SLOWDNS             ${CYAN}proximamente${NC}"
    echo -e "${YELLOW}[09]${NC} BADVPN UDPGW        $st_bad"
    echo -e "${YELLOW}[00]${NC} Volver"
    echo -e "${BLUE}-----------------------------------------------${NC}"
    echo ""
    read -rp "Opcion: " op
    case $op in
      1|01) ssh_ports_mgr;;
      2|02) squid_mgr;;
      3|03) dropbear;;
      4|04) openvpn_mgr;;
      5|05) ws_mgr;;
      6|06) ssl_tunnel_mgr;;
      7|07) sslh_mgr;;
      8|08) echo -e "\n${CYAN}SlowDNS: lo armamos en una pasada dedicada${NC}"; sleep 2;;
      9|09) badvpn_mgr;;
      0|00) break;;
      *) echo -e "${RED}Opcion invalida${NC}"; sleep 1;;
    esac
  done
}

