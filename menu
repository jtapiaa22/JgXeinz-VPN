backup(){
  while true; do
    banner "BACKUP DE USUARIOS"
    echo -e "${YELLOW}[1]${NC} Crear backup"
    echo -e "${YELLOW}[2]${NC} Restaurar backup"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " op
    case $op in
      1)
        local f tmp; f="$BKP/backup_$(date +%Y%m%d_%H%M%S).tar.gz"; tmp=$(mktemp -d)
        cp "$DB" "$tmp/users.db"; : > "$tmp/passwd.bak"; : > "$tmp/shadow.bak"
        while read -r user _; do
          [[ -z "$user" ]] && continue
          grep "^$user:" /etc/passwd >> "$tmp/passwd.bak"
          grep "^$user:" /etc/shadow >> "$tmp/shadow.bak"
        done < "$DB"
        tar -czf "$f" -C "$tmp" users.db passwd.bak shadow.bak
        rm -rf "$tmp"
        echo -e "\n${GREEN}Backup creado:${NC}\n$f"; pause;;
      2)
        mapfile -t files < <(ls -1 "$BKP"/*.tar.gz 2>/dev/null)
        [[ ${#files[@]} -eq 0 ]] && { echo -e "${RED}No hay backups${NC}"; pause; continue; }
        local i=1; for ff in "${files[@]}"; do echo -e "${YELLOW}[$i]${NC} $(basename "$ff")"; ((i++)); done
        echo ""; read -rp "Numero a restaurar: " s
        local file; file="${files[$((s-1))]}"; [[ -z "$file" ]] && { echo -e "${RED}Invalido${NC}"; pause; continue; }
        local tmp; tmp=$(mktemp -d); tar -xzf "$file" -C "$tmp"
        # recrear usuarios en el grupo del panel
        while IFS=: read -r user _; do
          [[ -z "$user" ]] && continue
          id "$user" &>/dev/null || useradd -M -s /bin/false -G "$VPN_GROUP" "$user"
        done < "$tmp/passwd.bak"
        # restaurar hash de contrasena Y fecha de vencimiento (campo 8 de shadow)
        while IFS=: read -r user hash d3 d4 d5 d6 d7 d8 _; do
          [[ -z "$user" ]] && continue
          usermod -p "$hash" "$user" 2>/dev/null
          if [[ -n "$d8" && "$d8" =~ ^[0-9]+$ ]]; then
            # campo 8 = dias desde epoch hasta el vencimiento
            chage -E "$(date -d "@$(( d8 * 86400 ))" +%Y-%m-%d)" "$user" 2>/dev/null
          fi
        done < "$tmp/shadow.bak"
        cp "$tmp/users.db" "$DB"; rm -rf "$tmp"
        echo -e "\n${GREEN}Backup restaurado (incluye fechas de vencimiento)${NC}"; pause;;
      0) break;;
      *) echo -e "${RED}Opcion invalida${NC}"; sleep 1;;
    esac
  done
}

optimizar(){
  banner "OPTIMIZAR RED (BBR)"
  modprobe tcp_bbr 2>/dev/null
  cat > /etc/sysctl.d/99-jgxeinz.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=4096 87380 16777216
net.ipv4.tcp_wmem=4096 65536 16777216
EOF
  sysctl --system >/dev/null 2>&1
  local cc; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
  echo -e "${GREEN}Optimizacion aplicada.${NC}"
  echo -e " Control de congestion: ${GREEN}$cc${NC}"
  [[ "$cc" == "bbr" ]] && echo -e " ${GREEN}BBR activo${NC}" || echo -e " ${YELLOW}BBR no se activo (kernel sin soporte)${NC}"
  pause
}

editar_banner(){
  banner "BANNER (MENSAJE AL CONECTAR)"
  local FS=$' '   # espacio invisible de ancho normal (no lo junta HTTP Custom)
  if [[ -f "$DIR/banner.txt" ]]; then
    # mostrar el actual con los invisibles convertidos a espacio real, para que se lea
    echo -e "Banner actual:\n${CYAN}$(sed "s/$FS/ /g" "$DIR/banner.txt")${NC}\n"
  else
    echo -e "(todavia no hay banner)\n"
  fi
  echo -e "${YELLOW}Escribi o pega tu banner.${NC} Los espacios para alinear/centrar se"
  echo -e "respetan solos (se convierten a invisibles para que HTTP Custom no los junte)."
  echo -e "Podes pegar arte ASCII tal cual. Para terminar: una linea con solo ${YELLOW}END${NC}\n"
  local tmp; tmp=$(mktemp)
  while IFS= read -r line; do
    [[ "$line" == "END" ]] && break
    # convertir cada espacio normal al invisible (asi sobrevive en la app)
    echo "${line// /$FS}" >> "$tmp"
  done
  [[ ! -s "$tmp" ]] && { rm -f "$tmp"; echo -e "${RED}Sin cambios${NC}"; pause; return; }
  mv "$tmp" "$DIR/banner.txt"
  echo "Banner $DIR/banner.txt" > /etc/ssh/sshd_config.d/10-jgxeinz-banner.conf
  systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
  echo -e "\n${GREEN}Banner actualizado y aplicado.${NC} Reconectate para verlo."; pause
}

# Dropbear corre con un servicio propio del panel (jgx-dropbear): el paquete
# cambia de nombre/config segun la distro y a veces ni trae claves. Con -R
# dropbear genera solo las claves que falten.
drop_on(){ systemctl is-active --quiet jgx-dropbear 2>/dev/null; }
drop_port(){ cat "$DIR/dropbear_port" 2>/dev/null; }

dropbear_start(){
  local p="$1" bin
  bin=$(command -v dropbear 2>/dev/null || echo /usr/sbin/dropbear)
  mkdir -p /etc/dropbear
  # el servicio del paquete (si existe) queda apagado para que no choque
  systemctl disable --now dropbear >/dev/null 2>&1
  cat > /etc/systemd/system/jgx-dropbear.service <<UNIT
[Unit]
Description=JgXeinz Dropbear
After=network.target
[Service]
ExecStart=$bin -F -E -R -p $p
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
UNIT
  echo "$p" > "$DIR/dropbear_port"
  systemctl daemon-reload
  systemctl enable jgx-dropbear >/dev/null 2>&1
  systemctl restart jgx-dropbear >/dev/null 2>&1
  sleep 1
  if drop_on; then
    echo -e "\n${GREEN}Dropbear activo en el puerto $p. Abrilo en AWS y usalo como otro metodo SSH.${NC}"
  else
    echo -e "\n${RED}No se pudo activar. Ultimos mensajes de dropbear:${NC}"
    # solo lo que dice dropbear, sin los avisos genericos de systemd
    journalctl -u jgx-dropbear -n 40 --no-pager -o cat 2>/dev/null \
      | grep -vE '^(jgx-dropbear\.service:|Failed to start|Started|Starting|Stopped|Stopping)' \
      | tail -5 | sed 's/^/  /'
  fi
}

dropbear_mgr(){
  while true; do
    banner "DROPBEAR (OTRO SERVIDOR SSH)"
    local p ocupa
    if drop_on; then
      echo -e "Estado: ${GREEN}ACTIVADO${NC}   Puerto: ${GREEN}$(drop_port)${NC}\n"
      echo -e "${YELLOW}[1]${NC} Cambiar puerto"
      echo -e "${YELLOW}[2]${NC} Desactivar"
      echo -e "${YELLOW}[0]${NC} Volver"
      echo ""; read -rp "Opcion: " o
      case $o in
        1) read -rp "Nuevo puerto: " p
           [[ ! "$p" =~ ^[0-9]+$ ]] && { echo -e "${RED}Puerto invalido${NC}"; pause; continue; }
           ocupa=$(quien_usa_puerto "$p")
           [[ -n "$ocupa" ]] && { echo -e "${RED}El puerto $p ya lo esta usando: ${WHITE}$ocupa${NC}"; pause; continue; }
           dropbear_start "$p"; pause;;
        2) systemctl disable --now jgx-dropbear >/dev/null 2>&1; echo -e "${GREEN}Dropbear desactivado${NC}"; pause;;
        0) break;;
      esac
    else
      echo -e "Estado: ${RED}DESACTIVADO${NC}\n"
      read -rp "Puerto para Dropbear [ej: 90] (ENTER o 0 para volver): " p
      [[ -z "$p" || "$p" == 0 ]] && break
      [[ ! "$p" =~ ^[0-9]+$ ]] && { echo -e "${RED}Puerto invalido${NC}"; pause; continue; }
      ocupa=$(quien_usa_puerto "$p")
      if [[ -n "$ocupa" ]]; then
        echo -e "\n${RED}El puerto $p ya lo esta usando: ${WHITE}$ocupa${NC}"
        echo -e "${YELLOW}Elegi otro puerto o libera ese primero.${NC}"; pause; continue
      fi
      command -v dropbear >/dev/null 2>&1 || { echo -e "${YELLOW}Instalando dropbear...${NC}"; apt-get install -y dropbear >/dev/null 2>&1; }
      grep -qx "/bin/false" /etc/shells 2>/dev/null || echo "/bin/false" >> /etc/shells
      dropbear_start "$p"
      pause
      # si no arranco, volver a Modo de conexion en vez de pedir el puerto de nuevo
      drop_on || break
    fi
  done
}

trafico(){
  while true; do
    banner "TRAFICO POR USUARIO"
    echo -e "${YELLOW}(aprox: mide la subida del servidor por usuario)${NC}\n"
    echo -e "${YELLOW}[1]${NC} Activar medicion"
    echo -e "${YELLOW}[2]${NC} Ver consumo"
    echo -e "${YELLOW}[3]${NC} Reiniciar contadores"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " o
    case $o in
      1)
        command -v iptables >/dev/null 2>&1 || { echo -e "${YELLOW}Instalando iptables...${NC}"; apt-get install -y iptables >/dev/null 2>&1; }
        while read -r user _; do
          [[ -z "$user" ]] && continue
          add_traffic_rule "$user"
        done < "$DB"
        echo -e "\n${GREEN}Medicion activada (y guardada para que sobreviva reinicios)${NC}"; pause;;
      2)
        banner "CONSUMO POR USUARIO"
        printf "${WHITE}%-18s %-12s${NC}\n" "USUARIO" "CONSUMO"
        echo "-----------------------------------"
        while read -r user _; do
          [[ -z "$user" ]] && continue
          local uid b mb; uid=$(id -u "$user" 2>/dev/null) || continue
          b=$(iptables -L OUTPUT -v -n -x 2>/dev/null | awk -v p="owner UID match $uid" '$0 ~ p {s+=$2} END{print s+0}')
          mb=$(( b / 1024 / 1024 ))
          printf "%-18s %-12s\n" "$user" "${mb} MB"
        done < "$DB"
        pause;;
      3) iptables -Z OUTPUT 2>/dev/null; echo -e "\n${GREEN}Contadores reiniciados${NC}"; pause;;
      0) break;;
      *) echo -e "${RED}Opcion invalida${NC}"; sleep 1;;
    esac
  done
}

set_dominio(){
  banner "DOMINIO DEL SERVIDOR"
  local cur; cur=$(cat "$DIR/domain" 2>/dev/null)
  echo -e " Actual: ${GREEN}${cur:-(ninguno, se usa la IP)}${NC}\n"
  echo -e "${YELLOW}[1]${NC} Poner / cambiar dominio"
  echo -e "${YELLOW}[2]${NC} Quitar dominio (volver a la IP)"
  echo -e "${YELLOW}[0]${NC} Volver"
  echo ""; read -rp "Opcion: " o
  case $o in
    1) read -rp "Dominio (ej: vps.tudominio.com): " d
       [[ -z "$d" ]] && { echo -e "${RED}Vacio${NC}"; pause; return; }
       echo "$d" > "$DIR/domain"
       echo -e "\n${GREEN}Dominio guardado: $d${NC}"
       echo -e "${YELLOW}Las cuentas nuevas saldran con el dominio.${NC}"; pause;;
    2) rm -f "$DIR/domain"; echo -e "\n${GREEN}Listo, se vuelve a usar la IP${NC}"; pause;;
