# fila de menu en 2 columnas parejas (el padding se hace sobre texto plano)
mrow(){
  local nL="$1" lL="$2" nR="$3" lR="$4"
  printf " ${YELLOW}[%s]${NC} %-24s" "$nL" "$lL"
  [[ -n "$nR" ]] && echo -ne "${YELLOW}[$nR]${NC} ${lR}"
  echo ""
}

