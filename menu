#!/bin/bash
#==============================================================
#  JgXeinz VPN  -  Panel de administracion
#  Compatible: Ubuntu 22.04 / 24.04 / 26.04 - Debian 12 / 13
#  Repo: https://github.com/TU_USUARIO/Script_VPS
#==============================================================

# ------------------- CONFIG (edita aca) -------------------
PANEL_NAME="JgXeinz VPN"
VERSION="1.0"
UDPGW_PORT="7300"
REPO="https://raw.githubusercontent.com/jtapiaa22/JgXeinz-VPN/main"
# ----------------------------------------------------------

DIR="/etc/jgxeinz"
DB="$DIR/users.db"
PROXY="$DIR/proxy.py"
BKP="$DIR/backup"

RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'
BLUE='\033[1;34m'; CYAN='\033[1;36m'; WHITE='\033[1;37m'; NC='\033[0m'

[[ $EUID -ne 0 ]] && { echo -e "${RED}Tenes que ejecutarlo como root (usa: sudo -i)${NC}"; exit 1; }
mkdir -p "$DIR" "$BKP"; touch "$DB"

pause(){ echo ""; read -rp "$(echo -e "${CYAN}Presiona ENTER para volver...${NC}")" _; }

get_ip(){ curl -s --max-time 5 https://ipv4.icanhazip.com 2>/dev/null || hostname -I | awk '{print $1}'; }

banner(){
  clear
  echo -e "${BLUE}===============================================${NC}"
  if command -v figlet >/dev/null 2>&1; then
    echo -e "${CYAN}$(figlet -w 80 -f small "$PANEL_NAME" 2>/dev/null || echo "   $PANEL_NAME")${NC}"
  else
    echo -e "${CYAN}                  $PANEL_NAME${NC}"
  fi
  echo -e "${BLUE}===============================================${NC}"
}

# --------------------------------------------------------------
#  GESTION DE USUARIOS
# --------------------------------------------------------------
gen_cuenta(){
  # args: user pass exp limite
  local user="$1" pass="$2" exp="$3" limite="$4"
  local ip sshp dropp wsp ovpnp sslp badp dias
  ip=$(get_ip)
  local host; host=$(cat "$DIR/domain" 2>/dev/null); [[ -z "$host" ]] && host="$ip"
  sshp=$(grep -i '^port' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | paste -sd, -)
  systemctl is-active --quiet dropbear 2>/dev/null && dropp=$(grep '^DROPBEAR_PORT=' /etc/default/dropbear 2>/dev/null | cut -d= -f2)
  wsp=$(systemctl list-units 'jgx-ws@*' --state=active --no-legend 2>/dev/null | grep -oP 'jgx-ws@\K[0-9]+' | paste -sd, -)
  systemctl is-active --quiet openvpn@server 2>/dev/null && ovpnp=$(grep -i '^port' /etc/openvpn/server.conf 2>/dev/null | awk '{print $2}')
  systemctl is-active --quiet stunnel4 2>/dev/null && sslp=$(grep -i '^accept' /etc/stunnel/stunnel.conf 2>/dev/null | grep -oP '[0-9]+' | paste -sd, -)
  badp=$(systemctl list-units 'jgx-badvpn@*' --state=active --no-legend 2>/dev/null | grep -oP 'jgx-badvpn@\K[0-9]+' | paste -sd, -)
  if [[ -n "$exp" && "$exp" != "nunca" ]]; then
    dias=$(( ( $(date -d "$exp" +%s 2>/dev/null) - $(date +%s) ) / 86400 ))
  fi
  mkdir -p "$DIR/cuentas"
  local f="$DIR/cuentas/$user.txt"
  {
    echo "=============================================="
    echo "         CUENTA CREADA EXITOSAMENTE"
    echo "=============================================="
    echo " Tipo        : NORMAL"
    echo " Usuario/ID  : $user"
    echo " Contrasena  : $pass"
    echo " Expira      : $exp${dias:+ ($dias dias)}"
    echo " Limite IP   : ${limite:-1}"
    echo "----------------------------------------------"
    echo " Host        : $host"
    [[ -n "$sshp" ]]  && echo " Puertos SSH : $sshp"
    [[ -n "$dropp" ]] && echo " Dropbear    : $dropp"
    [[ -n "$wsp" ]]   && echo " Websocket   : $wsp"
    [[ -n "$ovpnp" ]] && echo " OpenVPN     : $ovpnp"
    [[ -n "$sslp" ]]  && echo " SSL Tunnel  : $sslp"
    [[ -n "$badp" ]]  && echo " BadVPN      : $badp"
    echo "----------------------------------------------"
    echo " HTTP CUSTOM :"
    for p in $(echo "$sshp,$wsp,$sslp" | tr ',' '\n' | grep -v '^$' | sort -un); do
      echo "   $host:$p@$user:$pass"
    done
    if [[ -n "$badp" ]]; then
      echo "----------------------------------------------"
      echo " UDP CUSTOM  :"
      echo "   $host:1-65535@$user:$pass"
    fi
    echo "=============================================="
  } | tee "$f"
  chmod 600 "$f" 2>/dev/null
  echo -e "\n${YELLOW}(Guardado; se vuelve a ver con la opcion 16)${NC}"
}

datos_cuenta(){
  banner; echo -e "${WHITE} DATOS DE CUENTA${NC}\n"
  mapfile -t us < <(ls -1 "$DIR/cuentas"/*.txt 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.txt$//')
  [[ ${#us[@]} -eq 0 ]] && { echo -e "${RED}No hay cuentas guardadas (se guardan al crear usuarios).${NC}"; pause; return; }
  local i=1; for u in "${us[@]}"; do echo -e "${YELLOW}[$i]${NC} $u"; ((i++)); done
  echo ""; read -rp "Numero o nombre: " sel
  local user
  if [[ "$sel" =~ ^[0-9]+$ ]]; then user="${us[$((sel-1))]}"; else user="$sel"; fi
  [[ -z "$user" || ! -f "$DIR/cuentas/$user.txt" ]] && { echo -e "${RED}No encontrado${NC}"; pause; return; }
  echo ""; cat "$DIR/cuentas/$user.txt"
  pause
}

crear_usuario(){
  banner; echo -e "${WHITE} CREAR USUARIO${NC}\n"
  read -rp "Nombre de usuario: " user
  [[ -z "$user" ]] && { echo -e "${RED}Usuario vacio${NC}"; pause; return; }
  id "$user" &>/dev/null && { echo -e "${RED}Ese usuario ya existe${NC}"; pause; return; }
  read -rp "Contrasena: " pass
  [[ -z "$pass" ]] && { echo -e "${RED}Contrasena vacia${NC}"; pause; return; }
  read -rp "Dias de validez: " dias
  [[ ! "$dias" =~ ^[0-9]+$ ]] && { echo -e "${RED}Dias invalidos${NC}"; pause; return; }
  read -rp "Limite de conexiones: " limite
  [[ ! "$limite" =~ ^[0-9]+$ ]] && limite=1
  local exp; exp=$(date -d "+$dias days" +%Y-%m-%d)
  useradd -M -s /bin/false -e "$exp" "$user"
  echo "$user:$pass" | chpasswd
  sed -i "/^$user /d" "$DB"
  echo "$user $limite" >> "$DB"
  echo ""
  echo -e "${GREEN}Usuario creado con exito${NC}\n"
  gen_cuenta "$user" "$pass" "$exp" "$limite"
  pause
}

crear_teste(){
  banner; echo -e "${WHITE} USUARIO DE PRUEBA${NC}\n"
  read -rp "Minutos de validez [por defecto 30]: " mins
  [[ ! "$mins" =~ ^[0-9]+$ ]] && mins=30
  local user pass; user="test$(shuf -i 100-999 -n1)"; pass="$(shuf -i 1000-9999 -n1)"
  useradd -M -s /bin/false "$user"
  echo "$user:$pass" | chpasswd
  sed -i "/^$user /d" "$DB"
  echo "$user 1" >> "$DB"
  # borrado automatico al vencer (no deja basura)
  systemd-run --on-active="${mins}min" /bin/bash -c "userdel --force $user 2>/dev/null; sed -i '/^$user /d' $DB" >/dev/null 2>&1
  echo ""
  echo -e "${GREEN}Usuario de prueba creado${NC}"
  echo -e "${WHITE}----------------------------------${NC}"
  echo -e " Usuario : ${GREEN}$user${NC}"
  echo -e " Clave   : ${GREEN}$pass${NC}"
  echo -e " Dura    : ${GREEN}$mins minutos${NC}"
  echo -e " IP      : ${GREEN}$(get_ip)${NC}"
  echo -e "${WHITE}----------------------------------${NC}"
  pause
}

remover_usuario(){
  banner; echo -e "${WHITE} REMOVER USUARIO${NC}\n"
  mapfile -t users < <(awk '{print $1}' "$DB")
  [[ ${#users[@]} -eq 0 ]] && { echo -e "${RED}No hay usuarios${NC}"; pause; return; }
  local i=1; for u in "${users[@]}"; do echo -e "${YELLOW}[$i]${NC} $u"; ((i++)); done
  echo ""; read -rp "Numero o nombre a remover: " sel
  local user
  if [[ "$sel" =~ ^[0-9]+$ ]]; then user="${users[$((sel-1))]}"; else user="$sel"; fi
  [[ -z "$user" ]] && { echo -e "${RED}Seleccion invalida${NC}"; pause; return; }
  pkill -u "$user" 2>/dev/null
  userdel --force "$user" 2>/dev/null
  sed -i "/^$user /d" "$DB"
  echo -e "\n${GREEN}Usuario $user eliminado${NC}"; pause
}

monitor_online(){
  banner; echo -e "${WHITE} MONITOR ONLINE${NC}\n"
  printf "${WHITE}%-18s %-10s %-8s${NC}\n" "USUARIO" "ESTADO" "CONEX"
  echo "-------------------------------------"
  local online=0 total=0
  while read -r user limite; do
    [[ -z "$user" ]] && continue
    [[ -z "$limite" ]] && limite=1
    local n; n=$(ps -u "$user" 2>/dev/null | grep -c sshd)
    total=$((total+n))
    if [[ "$n" -gt 0 ]]; then
      printf "${GREEN}%-18s %-10s %-8s${NC}\n" "$user" "ONLINE" "$n/$limite"
      online=$((online+1))
    else
      printf "%-18s ${RED}%-10s${NC} %-8s\n" "$user" "offline" "0/$limite"
    fi
  done < "$DB"
  echo "-------------------------------------"
  echo -e "${WHITE}Usuarios online: ${GREEN}$online${WHITE}    Conexiones: ${GREEN}$total${NC}"
  pause
}

cambiar_fecha(){
  banner; echo -e "${WHITE} CAMBIAR FECHA DE VENCIMIENTO${NC}\n"
  read -rp "Usuario: " user
  id "$user" &>/dev/null || { echo -e "${RED}Ese usuario no existe${NC}"; pause; return; }
  read -rp "Nuevos dias de validez: " dias
  [[ ! "$dias" =~ ^[0-9]+$ ]] && { echo -e "${RED}Dias invalidos${NC}"; pause; return; }
  local exp; exp=$(date -d "+$dias days" +%Y-%m-%d)
  chage -E "$exp" "$user"
  echo -e "\n${GREEN}Nueva fecha de vencimiento: $exp${NC}"; pause
}

cambiar_limite(){
  banner; echo -e "${WHITE} CAMBIAR LIMITE DE CONEXIONES${NC}\n"
  read -rp "Usuario: " user
  grep -q "^$user " "$DB" || { echo -e "${RED}Ese usuario no esta en la base${NC}"; pause; return; }
  read -rp "Nuevo limite: " limite
  [[ ! "$limite" =~ ^[0-9]+$ ]] && { echo -e "${RED}Limite invalido${NC}"; pause; return; }
  sed -i "/^$user /d" "$DB"
  echo "$user $limite" >> "$DB"
  echo -e "\n${GREEN}Limite de $user ahora es $limite${NC}"
  echo -e "${YELLOW}(El control real del limite se agrega en la etapa 2)${NC}"; pause
}

cambiar_senha(){
  banner; echo -e "${WHITE} CAMBIAR CONTRASENA${NC}\n"
  read -rp "Usuario: " user
  id "$user" &>/dev/null || { echo -e "${RED}Ese usuario no existe${NC}"; pause; return; }
  read -rp "Nueva contrasena: " pass
  [[ -z "$pass" ]] && { echo -e "${RED}Contrasena vacia${NC}"; pause; return; }
  echo "$user:$pass" | chpasswd
  echo -e "\n${GREEN}Contrasena de $user actualizada${NC}"; pause
}

remover_expirados(){
  banner; echo -e "${WHITE} REMOVER EXPIRADOS${NC}\n"
  local hoy n=0; hoy=$(date +%s)
  while read -r user _; do
    [[ -z "$user" ]] && continue
    local exp exp_s; exp=$(chage -l "$user" 2>/dev/null | grep -i "account expires" | cut -d: -f2- | xargs)
    [[ "$exp" == "never" || -z "$exp" ]] && continue
    exp_s=$(date -d "$exp" +%s 2>/dev/null) || continue
    if (( exp_s < hoy )); then
      pkill -u "$user" 2>/dev/null
      userdel --force "$user" 2>/dev/null
      sed -i "/^$user /d" "$DB"
      echo -e "${RED}Eliminado: $user${NC}"; ((n++))
    fi
  done < "$DB"
  echo -e "\n${GREEN}$n usuario(s) expirado(s) eliminado(s)${NC}"; pause
}

reporte(){
  banner; echo -e "${WHITE} REPORTE DE USUARIOS${NC}\n"
  printf "${WHITE}%-16s %-12s %-7s %-6s${NC}\n" "USUARIO" "VENCE" "DIAS" "LIMITE"
  echo "-------------------------------------------"
  local hoy; hoy=$(date +%s)
  while read -r user limite; do
    [[ -z "$user" ]] && continue
    local exp exp_s dias
    exp=$(chage -l "$user" 2>/dev/null | grep -i "account expires" | cut -d: -f2- | xargs)
    if [[ "$exp" == "never" || -z "$exp" ]]; then
      dias="-"; exp="nunca"
    else
      exp_s=$(date -d "$exp" +%s 2>/dev/null)
      dias=$(( (exp_s - hoy) / 86400 ))
    fi
    printf "%-16s %-12s %-7s %-6s\n" "$user" "$exp" "$dias" "$limite"
  done < "$DB"
  pause
}

# --------------------------------------------------------------
#  MODO DE CONEXION
# --------------------------------------------------------------
ws_on(){
  local p="$1"
  cat > /etc/systemd/system/jgx-ws@.service <<EOF
[Unit]
Description=JgXeinz WebSocket proxy %i
After=network.target
[Service]
ExecStart=/usr/bin/python3 $PROXY %i
Restart=always
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl reset-failed jgx-ws@"$p" 2>/dev/null
  systemctl enable --now jgx-ws@"$p" >/dev/null 2>&1
  sleep 1
  if ss -tlnp 2>/dev/null | grep -q ":$p "; then
    echo -e "${GREEN}WebSocket activo en el puerto $p${NC}"
    echo -e "${YELLOW}Acordate de abrir el puerto $p en el grupo de seguridad de AWS${NC}"
  else
    echo -e "${RED}No se pudo activar. Puede que el puerto $p ya este en uso.${NC}"
  fi
}

badvpn_on(){
  local p="$1"
  local bin; bin=$(command -v badvpn-udpgw)
  [[ -z "$bin" ]] && { echo -e "${RED}badvpn-udpgw no esta instalado (reinstala el panel o compilalo).${NC}"; return; }
  # migrar del servicio viejo unico, si existia
  systemctl disable --now jgx-badvpn >/dev/null 2>&1
  rm -f /etc/systemd/system/jgx-badvpn.service 2>/dev/null
  cat > /etc/systemd/system/jgx-badvpn@.service <<EOF
[Unit]
Description=JgXeinz BadVPN UDPGW %i
After=network.target
[Service]
ExecStart=$bin --listen-addr 127.0.0.1:%i --max-clients 500 --max-connections-for-client 10
Restart=always
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now jgx-badvpn@"$p" >/dev/null 2>&1
  sleep 1
  systemctl is-active --quiet jgx-badvpn@"$p" \
    && echo -e "${GREEN}BadVPN activo en 127.0.0.1:$p${NC}" \
    || echo -e "${RED}No se pudo activar en $p${NC}"
}

ssh_ports_mgr(){
  while true; do
    banner; echo -e "${WHITE} OPENSSH${NC}\n"
    echo -e " Puertos SSH: ${GREEN}$(grep -i '^port' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | xargs)${NC}\n"
    echo -e "${YELLOW}[1]${NC} Agregar puerto"
    echo -e "${YELLOW}[2]${NC} Quitar puerto"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " o
    case $o in
      1) read -rp "Puerto a agregar: " p
         [[ "$p" =~ ^[0-9]+$ ]] && { echo "Port $p" >> /etc/ssh/sshd_config; systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null; echo -e "${GREEN}Agregado. Abrilo en AWS.${NC}"; } || echo -e "${RED}Invalido${NC}"; pause;;
      2) read -rp "Puerto a quitar: " p
         sed -i "/^Port $p\$/d" /etc/ssh/sshd_config; systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null; echo -e "${GREEN}Listo${NC}"; pause;;
      0) break;;
    esac
  done
}

ws_mgr(){
  while true; do
    banner; echo -e "${WHITE} PROXY SOCKS / WEBSOCKET${NC}\n"
    local ports; ports=$(systemctl list-units 'jgx-ws@*' --state=active --no-legend 2>/dev/null | grep -oP 'jgx-ws@\K[0-9]+' | xargs)
    echo -e " Puertos activos: ${GREEN}${ports:-ninguno}${NC}\n"
    echo -e "${YELLOW}[1]${NC} Activar en un puerto"
    echo -e "${YELLOW}[2]${NC} Desactivar un puerto"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " o
    case $o in
      1) read -rp "Puerto: " p; [[ "$p" =~ ^[0-9]+$ ]] && ws_on "$p" || echo -e "${RED}Puerto invalido${NC}"; pause;;
      2) read -rp "Puerto a desactivar: " p; systemctl disable --now jgx-ws@"$p" >/dev/null 2>&1; echo -e "${GREEN}Desactivado${NC}"; pause;;
      0) break;;
    esac
  done
}

badvpn_mgr(){
  while true; do
    banner; echo -e "${WHITE} BADVPN UDPGW (voz/UDP)${NC}\n"
    local ports; ports=$(systemctl list-units 'jgx-badvpn@*' --state=active --no-legend 2>/dev/null | grep -oP 'jgx-badvpn@\K[0-9]+' | xargs)
    echo -e " Puertos activos: ${GREEN}${ports:-ninguno}${NC}"
    echo -e " ${YELLOW}(corren en 127.0.0.1 y van por el tunel: NO se abren en AWS)${NC}\n"
    echo -e "${YELLOW}[1]${NC} Agregar puerto"
    echo -e "${YELLOW}[2]${NC} Quitar puerto"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " o
    case $o in
      1) read -rp "Puerto (ej: 7300): " p; [[ "$p" =~ ^[0-9]+$ ]] && badvpn_on "$p" || echo -e "${RED}Puerto invalido${NC}"; pause;;
      2) read -rp "Puerto a quitar: " p; systemctl disable --now jgx-badvpn@"$p" >/dev/null 2>&1; echo -e "${GREEN}Quitado${NC}"; pause;;
      0) break;;
    esac
  done
}

squid_mgr(){
  banner; echo -e "${WHITE} SQUID PROXY${NC}\n"
  if systemctl is-active --quiet squid 2>/dev/null; then
    local sp; sp=$(ss -tlnp 2>/dev/null | grep squid | grep -oP ':\K[0-9]+' | sort -u | xargs)
    echo -e "Estado: ${GREEN}ACTIVADO${NC}   Puertos: ${GREEN}$sp${NC}\n"
    read -rp "Desactivar Squid? [s/n]: " r
    [[ "$r" =~ ^[sS]$ ]] && { systemctl disable --now squid >/dev/null 2>&1; echo -e "${GREEN}Squid desactivado${NC}"; }
  else
    echo -e "Estado: ${RED}DESACTIVADO${NC}\n"
    read -rp "Puertos para Squid (ej: 8080 3128): " ports
    [[ -z "$ports" ]] && { echo -e "${RED}Sin puertos${NC}"; pause; return; }
    command -v squid >/dev/null 2>&1 || { echo -e "${YELLOW}Instalando squid...${NC}"; apt-get install -y squid >/dev/null 2>&1; }
    local ip; ip=$(get_ip)
    {
      echo "acl conectar method CONNECT"
      echo "acl selfdst dst 127.0.0.1/32 $ip/32"
      echo "http_access allow conectar selfdst"
      echo "http_access deny all"
      for p in $ports; do echo "http_port $p"; done
      echo "visible_hostname JgXeinz"
      echo "via off"
      echo "forwarded_for off"
    } > /etc/squid/squid.conf
    systemctl enable squid >/dev/null 2>&1
    systemctl restart squid >/dev/null 2>&1
    systemctl is-active --quiet squid \
      && echo -e "\n${GREEN}Squid activo en: $ports (abrilos en AWS)${NC}" \
      || echo -e "\n${RED}No se pudo activar${NC}"
  fi
  pause
}

ssl_tunnel_mgr(){
  banner; echo -e "${WHITE} SSL TUNNEL (stunnel)${NC}\n"
  if systemctl is-active --quiet stunnel4 2>/dev/null; then
    local sp; sp=$(grep -i '^accept' /etc/stunnel/stunnel.conf 2>/dev/null | grep -oP '[0-9]+' | xargs)
    echo -e "Estado: ${GREEN}ACTIVADO${NC}   Puerto: ${GREEN}$sp${NC}\n"
    read -rp "Desactivar SSL Tunnel? [s/n]: " r
    [[ "$r" =~ ^[sS]$ ]] && { systemctl disable --now stunnel4 >/dev/null 2>&1; echo -e "${GREEN}Desactivado${NC}"; }
  else
    echo -e "Estado: ${RED}DESACTIVADO${NC}\n"
    read -rp "Puerto para SSL Tunnel [443]: " p
    [[ -z "$p" ]] && p=443
    [[ ! "$p" =~ ^[0-9]+$ ]] && { echo -e "${RED}Puerto invalido${NC}"; pause; return; }
    command -v stunnel4 >/dev/null 2>&1 || { echo -e "${YELLOW}Instalando stunnel...${NC}"; apt-get install -y stunnel4 >/dev/null 2>&1; }
    [[ ! -f /etc/stunnel/stunnel.pem ]] && openssl req -new -x509 -days 1095 -nodes -subj "/CN=JgXeinz" -out /etc/stunnel/stunnel.pem -keyout /etc/stunnel/stunnel.pem >/dev/null 2>&1
    cat > /etc/stunnel/stunnel.conf <<EOF
pid = /var/run/stunnel4.pid
cert = /etc/stunnel/stunnel.pem
[ssh]
accept = $p
connect = 127.0.0.1:22
EOF
    sed -i 's/^ENABLED=0/ENABLED=1/' /etc/default/stunnel4 2>/dev/null
    systemctl enable stunnel4 >/dev/null 2>&1
    systemctl restart stunnel4 >/dev/null 2>&1
    systemctl is-active --quiet stunnel4 \
      && echo -e "\n${GREEN}SSL Tunnel activo en el puerto $p (abrilo en AWS)${NC}" \
      || echo -e "\n${RED}No se pudo activar${NC}"
  fi
  pause
}

sslh_mgr(){
  banner; echo -e "${WHITE} SSLH MULTIPLEX${NC}\n"
  if systemctl is-active --quiet sslh 2>/dev/null; then
    echo -e "Estado: ${GREEN}ACTIVADO${NC}\n"
    read -rp "Desactivar SSLH? [s/n]: " r
    [[ "$r" =~ ^[sS]$ ]] && { systemctl disable --now sslh >/dev/null 2>&1; echo -e "${GREEN}Desactivado${NC}"; }
  else
    echo -e "Un solo puerto que reparte SSH / SSL / HTTP.\n"
    read -rp "Puerto para SSLH [443]: " p
    [[ -z "$p" ]] && p=443
    [[ ! "$p" =~ ^[0-9]+$ ]] && { echo -e "${RED}Puerto invalido${NC}"; pause; return; }
    command -v sslh >/dev/null 2>&1 || { echo -e "${YELLOW}Instalando sslh...${NC}"; apt-get install -y sslh >/dev/null 2>&1; }
    local sslp; sslp=$(grep -i '^accept' /etc/stunnel/stunnel.conf 2>/dev/null | grep -oP '[0-9]+' | head -1)
    mkdir -p /var/run/sslh
    cat > /etc/default/sslh <<EOF
RUN=yes
DAEMON=/usr/sbin/sslh
DAEMON_OPTS="--user sslh --listen 0.0.0.0:$p --ssh 127.0.0.1:22 --tls 127.0.0.1:${sslp:-444} --http 127.0.0.1:80 --pidfile /var/run/sslh/sslh.pid"
EOF
    systemctl enable sslh >/dev/null 2>&1
    systemctl restart sslh >/dev/null 2>&1
    systemctl is-active --quiet sslh \
      && echo -e "\n${GREEN}SSLH activo en el puerto $p (abrilo en AWS)${NC}" \
      || echo -e "\n${RED}No se pudo activar (puede que el puerto este ocupado)${NC}"
  fi
  pause
}

openvpn_install(){
  local PORT="$1"
  echo -e "${YELLOW}Instalando paquetes...${NC}"
  apt-get update -y >/dev/null 2>&1
  apt-get install -y openvpn easy-rsa iptables >/dev/null 2>&1
  local E=/etc/openvpn/easy-rsa
  rm -rf "$E"
  make-cadir "$E" >/dev/null 2>&1 || { mkdir -p "$E"; cp -r /usr/share/easy-rsa/* "$E"/ 2>/dev/null; }
  cd "$E" || { echo -e "${RED}No se encontro easy-rsa${NC}"; return; }
  echo -e "${YELLOW}Generando certificados (puede tardar 1-2 min)...${NC}"
  ./easyrsa init-pki >/dev/null 2>&1
  ./easyrsa --batch build-ca nopass >/dev/null 2>&1
  ./easyrsa --batch build-server-full server nopass >/dev/null 2>&1
  ./easyrsa --batch build-client-full jgxeinz nopass >/dev/null 2>&1
  ./easyrsa gen-dh >/dev/null 2>&1
  openvpn --genkey secret /etc/openvpn/ta.key >/dev/null 2>&1
  cp pki/ca.crt pki/issued/server.crt pki/private/server.key pki/dh.pem /etc/openvpn/ 2>/dev/null
  cat > /etc/openvpn/server.conf <<EOF
port $PORT
proto tcp
dev tun
ca ca.crt
cert server.crt
key server.key
dh dh.pem
tls-auth ta.key 0
topology subnet
server 10.8.0.0 255.255.255.0
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 1.1.1.1"
keepalive 10 120
data-ciphers AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-256-CBC
persist-key
persist-tun
user nobody
group nogroup
status /var/log/openvpn-status.log
verb 3
EOF
  echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-jgx-ovpn.conf
  sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
  local nic; nic=$(ip route | awk '/default/{print $5; exit}')
  iptables -t nat -C POSTROUTING -s 10.8.0.0/24 -o "$nic" -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o "$nic" -j MASQUERADE
  DEBIAN_FRONTEND=noninteractive apt-get install -y iptables-persistent >/dev/null 2>&1
  netfilter-persistent save >/dev/null 2>&1
  systemctl enable openvpn@server >/dev/null 2>&1
  systemctl restart openvpn@server >/dev/null 2>&1
  sleep 2
  local ip; ip=$(get_ip)
  cat > /root/jgxeinz-ovpn.ovpn <<EOF
client
dev tun
proto tcp
remote $ip $PORT
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-256-CBC
auth-nocache
verb 3
key-direction 1
<ca>
$(cat /etc/openvpn/ca.crt)
</ca>
<cert>
$(cat "$E/pki/issued/jgxeinz.crt")
</cert>
<key>
$(cat "$E/pki/private/jgxeinz.key")
</key>
<tls-auth>
$(cat /etc/openvpn/ta.key)
</tls-auth>
EOF
  if systemctl is-active --quiet openvpn@server; then
    echo -e "\n${GREEN}OpenVPN activo en el puerto $PORT (tcp). Abrilo en AWS.${NC}"
    echo -e "${GREEN}Config del cliente: /root/jgxeinz-ovpn.ovpn${NC}"
  else
    echo -e "\n${RED}No se pudo iniciar. Revisa: journalctl -u openvpn@server${NC}"
  fi
}

openvpn_mgr(){
  banner; echo -e "${WHITE} OPENVPN${NC}\n"
  if systemctl is-active --quiet openvpn@server 2>/dev/null; then
    local op; op=$(grep -i '^port' /etc/openvpn/server.conf 2>/dev/null | awk '{print $2}')
    echo -e "Estado: ${GREEN}ACTIVADO${NC}   Puerto: ${GREEN}$op (tcp)${NC}\n"
    echo -e "${YELLOW}[1]${NC} Ver la config del cliente (.ovpn)"
    echo -e "${YELLOW}[2]${NC} Remover OpenVPN"
    echo -e "${YELLOW}[0]${NC} Volver"
    echo ""; read -rp "Opcion: " o
    case $o in
      1) echo -e "\n${GREEN}Archivo:${NC} /root/jgxeinz-ovpn.ovpn"
         echo -e "${YELLOW}Pasalo a tu dispositivo y abrilo con la app OpenVPN.${NC}"
         echo -e "Para verlo en pantalla: ${CYAN}cat /root/jgxeinz-ovpn.ovpn${NC}"; pause;;
      2) read -rp "Seguro que queres remover OpenVPN? [s/n]: " r
         [[ "$r" =~ ^[sS]$ ]] && { systemctl disable --now openvpn@server >/dev/null 2>&1; apt-get remove --purge -y openvpn >/dev/null 2>&1; rm -rf /etc/openvpn/easy-rsa /etc/openvpn/server.conf /etc/openvpn/ca.crt /etc/openvpn/server.crt /etc/openvpn/server.key /etc/openvpn/dh.pem /etc/openvpn/ta.key /root/jgxeinz-ovpn.ovpn; echo -e "${GREEN}OpenVPN removido${NC}"; }
         pause;;
      0) :;;
