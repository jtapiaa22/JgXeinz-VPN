set_zona(){
  banner "ZONA HORARIA"
  echo -e " Actual: ${GREEN}$(timedatectl show -p Timezone --value 2>/dev/null)${NC}\n"
  echo -e "Los vencimientos se calculan por dia, asi que conviene la zona local."
  read -rp "Zona (ENTER para America/Argentina/Catamarca): " tz
  [[ -z "$tz" ]] && tz="America/Argentina/Catamarca"
  if timedatectl set-timezone "$tz" 2>/dev/null; then
    echo -e "\n${GREEN}Zona horaria: $tz${NC}"
  else
    echo -e "\n${RED}Zona invalida. Mira la lista con: timedatectl list-timezones${NC}"
